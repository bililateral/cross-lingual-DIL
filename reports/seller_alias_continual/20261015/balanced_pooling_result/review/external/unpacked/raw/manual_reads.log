  219 def projection(m: dict) -> dict:
  220     keys = [f"{k}_{a}" for a in method.ARMS for k in ("t_A", "t_B", "v", "h")]
  221     keys += ["L", "s_F", "r_F", "s_I", "r_I", "W_F", "W_I"]
  222     if any(not np.isfinite(m[k]) or m[k] <= 0 for k in keys):
  223         raise ValueError("Actual positive finite measurements for every arm required")
  224     train = 288*sum(m["t_A_"+a]+m["t_B_"+a] for a in method.ARMS)
  225     forward = sum(1446*m["v_"+a]+36*m["h_"+a] for a in method.ARMS)
  226     io = 3*m["L"]+6*(m["s_F"]+m["r_F"]+m["s_I"]+m["r_I"])
  227     seconds = 1.25*(train+forward+io+3600)
  228     size = math.ceil(1.1*(m["W_F"]+6*m["W_I"]+2*2**30))
  229     return {"train_seconds": train, "forward_seconds": forward, "io_seconds": io,
  230             "projected_total_seconds": seconds, "projected_peak_output_bytes": size,
  231             "within_budget": seconds <= policy()["runtime"]["maximum_gpu_stage_seconds"] and size <= 16*2**30}
  232 
