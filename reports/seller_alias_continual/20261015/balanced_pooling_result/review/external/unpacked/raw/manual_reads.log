  455 def blind_gate(root: Path, manifest: dict) -> tuple[dict, dict]:
  456     if (manifest["status"] != COMPLETE or manifest["source_files"] != sources()
  457             or manifest["physical_updates"] != 1728 or manifest["gradient_group_presentations"] != 2592
  458             or any(set(manifest[k]) != set(POINTS) for k in ("points", "training", "diagnostics"))
  459             or any(set(manifest[k]) != set(method.ARMS) for k in ("starts", "initials"))):
  460         raise ValueError("Incomplete source-bound blind experiment")
