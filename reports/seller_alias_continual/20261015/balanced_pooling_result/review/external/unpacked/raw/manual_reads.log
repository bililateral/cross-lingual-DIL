  277 def restore_point(path, expected, model, optimizer, arm):
  278     meta = core.restore_state(path, model, optimizer, expected["state_sha256"])
  279     if method.bind(model, meta) != arm:
  280         raise ValueError("Restored arm differs")
  281     for m, mode in zip(model.modules(), meta["modes"], strict=True):
  282         m.training = mode
  283     diag.restore_rng(meta["rng"])
