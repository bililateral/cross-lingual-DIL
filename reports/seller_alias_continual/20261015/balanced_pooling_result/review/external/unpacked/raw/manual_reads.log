  462     valid_ids = [r["group_uid"] for r in split["development"]]
  463     if len(valid_ids) != 40 or any(sum(r["domain"] == d for r in split["development"]) != 20 for d in "AB"):
  464         raise ValueError("AB valid coverage differs")
  465     fit = {r["group_uid"]: r["domain"] for r in split["fit"]}
  466     canonical = sorted(u for u, domain in fit.items() if domain == "A")
  467     if len(canonical) != 48:
  468         raise ValueError("Shared A fit scope differs")
  469     a_point = manifest["points"]["A_S"]
  470     shared = record.Memory.from_bytes(data.verify(root/a_point["memory"]["path"], a_point["memory"]).read_bytes())
  471     members = shared.summary()["members"]
  472     rng = random.Random(data.seed_for(20260930, "ABC", "retention"))
  473     retained = []
  474     for seen, uid in enumerate(sorted(canonical), 1):
  475         k = seen-1 if seen <= 6 else rng.randrange(seen)
  476         if k < 6:
  477             if k == len(retained):
  478                 retained.append(uid)
  479             else:
  480                 retained[k] = uid
  481     if retained != members:
  482         raise ValueError("Independent Algorithm R differs")
  483     for arm in method.ARMS:
  484         if (manifest["initials"][arm] != manifest["initials"]["S"]
  485                 or manifest["starts"][arm] != manifest["points"]["A_"+arm]["continuity"]):
  486             raise ValueError("Independent starts/own A continuation missing")
  487     scores, sequences = {}, {1: [], 2: []}
  488     for name in POINTS:
  489         point = manifest["points"][name]
  490         arm, stage = name[2:], "AB".index(name[0])+1
  491         a_point = manifest["points"]["A_"+arm]
