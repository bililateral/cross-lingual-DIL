  493                 or point["full_restore_verified"] is not True or point["inference_restore_verified"] is not True
  494                 or point["pooling"] != method.identity(arm)):
  495             raise ValueError("Endpoint restoration missing")
  496         logrec = manifest["training"][name]
  497         log = data.read_json(data.verify(root/logrec["path"], logrec))
  498         expected_fit = [r["group_uid"] for r in split["fit"] if r["domain"] == "AB"[stage-1]]
  499         stream = data.seed_for(20260918, "ABC", stage, "current")
  500         expected = data.schedule([type("ID", (), {"uid": u})() for u in expected_fit], 6, stream)
  501         if log["updates"] != 288 or len(log["rows"]) != 288 or log["adam_step"] != stage*288 or log["current_ids"] != [g.uid for g in expected]:
  502             raise ValueError("Main schedule/update count differs")
  503         memory = memory_from(data.verify(root/point["memory"]["path"], point["memory"]).read_bytes(), arm)
