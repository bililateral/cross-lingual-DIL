  287 def checkpoint(root, name, model, optimizer, memory, current, calibration, valid, c, arm, stage, budget):
  288     if len(calibration) != 12 or len(valid) != 40 or parent.adam_step(optimizer) != 288*stage:
  289         raise ValueError("Endpoint scope differs")
  290     optimizer.zero_grad(set_to_none=True)
  291     c = {**c, "pooling_stats": c.setdefault("pooling_stats", {}),
  292          "pooling_context": {"stage": stage, "step": 288, "role": "endpoint_prediction_or_restore"}}
  293     state, modes = diag.rng_state(), [m.training for m in model.modules()]
  294     with diag.neutral(model):
  295         scores = {"calibration": method.score(model, calibration, c, arm, budget.check),
  296                   "raw": method.score(model, valid, c, arm, budget.check)}
  297         mapping = parent.calibration.fit(scores["calibration"], np.asarray([g.labels for g in calibration], np.uint8),
  298                                          role="calibration", check=budget.check)
  299         if mapping["status"] != "PASS_CALIBRATION_FIT":
  300             raise ValueError("Calibration failed; no retry")
  301         current_map = dict(zip(("a", "b"), parent.calibration.parameters(mapping)))
  302         if memory is None:
  303             memory = record.Memory(method.RNG_ORDER)
  304         first_map = memory.maps.get("first", current_map)
  305         memory.maps = {"first": first_map, "stage": current_map, "rng": state,
  306                        "completed_stage": stage, "adam_step": stage*288, "pooling": method.identity(arm)}
  307         if stage == 1:
  308             memory.retain(current, 1, lambda g: record.reference(model, g, c, budget.check))
  309     mp = root/"memory"/(name+".bin")
  310     mp.write_bytes(memory.to_bytes())
  311     memory = memory_from(mp.read_bytes(), arm)
  312     meta = {"name": name, "rng": state, "modes": modes, "pooling": method.identity(arm),
  313             "members": [g.uid for g in memory.reservoir.groups], "maps": memory.maps,
  314             "memory": data.record(mp, root), "policy_sha256": data.sha256(POLICY)}
  315     full_path = root/"work"/(name+".pt")
  316     budget.check(base.persistence.checkpoint_reserve(model, optimizer))
  317     full = core.save_state(full_path, model, optimizer, meta)
  318     if restore_point(full_path, full, model, optimizer, arm) != meta:
  319         raise ValueError("Full model/Adam restore mismatch")
  320     with diag.neutral(model):
  321         for role, groups in (("calibration", calibration), ("raw", valid)):
  322             restored = method.restored_score(model, groups, c, budget.check)
  323             if not np.array_equal(scores[role], restored):
  324                 raise ValueError("Full restored scoring differs")
  325             scores["full-"+role] = restored
  326     model_path = root/"models"/(name+".pt")
  327     budget.check(base.persistence.checkpoint_reserve(model, None))
  328     inference = core.save_state(model_path, model, None, meta)
  329     if restore_point(model_path, inference, model, None, arm) != meta:
  330         raise ValueError("Inference restore mismatch")
  331     with diag.neutral(model):
  332         for role, groups in (("calibration", calibration), ("raw", valid)):
  333             restored = method.restored_score(model, groups, c, budget.check)
  334             if not np.array_equal(scores[role], restored):
  335                 raise ValueError("Inference restored scoring differs")
  336             scores["inference-"+role] = restored
  337     for role, mapping_value in (("stage-cal", current_map), ("first-cal", first_map)):
  338         scores[role] = parent.calibration.transform(scores["raw"], mapping_value)
  339         parent.calibration.preserve_order(scores["raw"], scores[role])
  340     map_path = root/"maps"/(name+".json")
  341     data.write_json(map_path, mapping)
  342     result = {"arm": arm, "stage": stage, "adam_step": parent.adam_step(optimizer),
  343         "full_restore_verified": True, "inference_restore_verified": True, "pooling": method.identity(arm),
  344         "calibration_ids": [g.uid for g in calibration], "maps": {"first": first_map, "stage": current_map},
  345         "mapping": data.record(map_path, root), "memory": data.record(mp, root), "memory_summary": memory.summary(),
  346         "continuity": continuity(model, optimizer, memory), "solver_summary": c.get("pooling_stats", {}).copy(),
  347         "full_state": {**full, "path": full_path.relative_to(root).as_posix()},
  348         "model": {**inference, "path": model_path.relative_to(root).as_posix()},
  349         "scores": {k: previous.save_array(root/"scores"/(name+"_"+k+".npy"), v, root) for k,v in scores.items()}}
  350     data.write_json(root/"points"/(name+".json"), result)
  351     base.persistence.remove_work_file(full_path, root)
  352     return result, memory
