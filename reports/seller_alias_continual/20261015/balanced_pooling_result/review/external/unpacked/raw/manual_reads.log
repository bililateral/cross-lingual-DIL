### result/step28_balanced_result_audit.py lines 1-339 / 339 SHA256 1adc3715328d749120207d153b89bdd131766dcc4af7ab605e886abc74160a16
    1 """Independent S/G/F saved-result audit. Linux py310; no labels, model or Memory loads.
    2 
    3 Reuses the closed C_q audit's diagnostic reconstruction. Reconstructs the fixed
    4 registered bootstrap, including nullable metrics, independent A trajectories and
    5 all three contrasts. Does not invoke production finalize or blind_gate.
    6 """
    7 import argparse
    8 import csv
    9 import hashlib
   10 import json
   11 import platform
   12 import time
   13 from datetime import datetime
   14 from pathlib import Path
   15 
   16 import numpy as np
   17 
   18 
   19 def read(path):
   20     return json.loads(path.read_text(encoding="utf-8"))
   21 
   22 
   23 def write(path, value):
   24     path.write_text(json.dumps(value, ensure_ascii=False, indent=2, allow_nan=False) + "\n", encoding="utf-8")
   25 
   26 
   27 def main():
   28     parser = argparse.ArgumentParser()
   29     parser.add_argument("--workspace", type=Path, required=True)
   30     parser.add_argument("--output", type=Path, required=True)
   31     args = parser.parse_args()
   32     started = time.perf_counter()
   33     args.output.mkdir(parents=True, exist_ok=False)
   34     root = args.workspace / "reports/job"
   35     run, evaluation = root / "run", root / "evaluation"
   36     manifest, completion = read(run / "manifest.json"), read(root / "completion.json")
   37     col, reported = read(evaluation / "collected.json"), read(evaluation / "evaluation.json")
   38     before, access, execution = (read(root / n) for n in ("before_valid.json", "access.json", "execution.json"))
   39     assert before["status"] == "ALL_BLIND_GATES_PASS"
   40     assert before["access"] == dict(train=1, valid=0, heldout=0, owners=0)
   41     assert access == completion["access"] == dict(train=1, valid=1, heldout=0, owners=0)
   42     assert completion["physical_updates"] == manifest["physical_updates"] == 1728
   43     assert completion["gradient_group_presentations"] == manifest["gradient_group_presentations"] == 2592
   44     assert not (root / "failure.json").exists()
   45     gate = read(args.workspace / execution["gate"]["path"])
   46     sources = completion["source_files"]
   47     assert len(sources) == 31
   48     for obj in (manifest, col, reported, before, gate):
   49         assert obj["source_files"] == sources
   50     assert execution["sources"] == sources
   51     checked_files = []
   52 
   53     def verify(parent, rec):
   54         p = parent / rec["path"]
   55         assert p.stat().st_size == rec["bytes"]
   56         assert hashlib.sha256(p.read_bytes()).hexdigest() == rec["sha256"]
   57         checked_files.append(str(p.relative_to(args.workspace)))
   58         return p
   59 
   60     for r in sources:
   61         verify(args.workspace, r)
   62         verify(run / "sources", r)
   63     verify(root, before["manifest"])
   64     points = [f"{d}_{a}" for a in "SGF" for d in "AB"]
   65     roles = ["raw", "stage-cal", "first-cal"]
   66     contrasts = [("F", "S"), ("G", "S"), ("F", "G")]
   67     assert set(manifest["points"]) == set(points)
   68     assert all(manifest["initials"][a] == manifest["initials"]["S"] for a in "SGF")
   69     assert all(manifest["starts"][a] == manifest["points"]["A_"+a]["continuity"] for a in "SGF")
   70     members = manifest["points"]["A_S"]["memory_summary"]["members"]
   71     rows = [np.flatnonzero(np.array(col["domains"]) == d) for d in "AB"]
   72     assert list(map(len, rows)) == [20, 20] and len(set(col["group_ids"])) == 40
   73     columns = col["columns"]
   74     assert len(columns) == 22
   75     errors, scalar_checks, all_csv = [], 0, []
   76 
   77     def compare(actual, expected):
   78         nonlocal scalar_checks
   79         a, b = np.asarray(actual, dtype=float), np.asarray(expected, dtype=float)
   80         assert a.shape == b.shape and np.array_equal(np.isnan(a), np.isnan(b))
   81         assert not np.isinf(a).any() and not np.isinf(b).any()
   82         difference = float(np.max(np.abs(a[~np.isnan(a)] - b[~np.isnan(b)]))) if (~np.isnan(a)).any() else 0.0
   83         errors.append(difference)
   84         scalar_checks += a.size
   85         assert difference <= 1e-12, difference
   86 
   87     draws = np.random.Generator(np.random.PCG64(20260930)).integers(20, size=(5000, 2, 20))
   88     frequencies = np.stack([np.stack([np.bincount(d, minlength=20) for d in draws[:, i]]) for i in range(2)])
   89 
   90     def audit_stats(values, target, domain_index, kind, point, role, domain):
   91         for j, metric in enumerate(columns):
   92             x, t = values[:, j], target[metric]
   93             missing = int(np.isnan(x).sum())
   94             if missing:
   95                 assert t["mean"] is None and t["conditional_95pct_interval"] is None
   96                 assert t["undefined_groups"] == missing and t["total_groups"] == 20
   97                 all_csv.append([kind, point, role, domain, metric, None, None, None])
   98             else:
   99                 estimates = frequencies[domain_index] @ x / 20
  100                 mean, bounds = x.mean(), np.percentile(estimates, [2.5, 97.5])
  101                 compare([mean, *bounds], [t["mean"], *t["conditional_95pct_interval"]])
  102                 all_csv.append([kind, point, role, domain, metric, mean, *bounds])
  103 
  104     matrices, absolute, classification = {}, {}, {}
  105     rank_columns = [i for i, k in enumerate(columns) if k not in {
  106         "brier", "log_loss", "precision", "recall", "f1", "specificity", "balanced_accuracy", "mcc"}]
  107     for point in points:
  108         p = manifest["points"][point]
  109         assert p["full_restore_verified"] and p["inference_restore_verified"]
  110         assert p["adam_step"] == (288 if point.startswith("A_") else 576)
  111         assert p["memory_summary"]["members"] == members and p["memory_summary"]["seen"] == 48
  112         assert p["memory_summary"]["bytes"] <= 1048576
  113         matrices[point], absolute[point], classification[point] = {}, {}, {}
  114         for role in roles:
  115             classification[point][role] = {}
  116             rec = col["points"][point][role]
  117             saved = read(verify(evaluation, rec["matrix"]))
  118             assert saved["columns"] == columns
  119             matrix = np.asarray(saved["values"], dtype=float)
  120             assert matrix.shape == (40, 22) and not np.isinf(matrix).any()
  121             matrices[point][role] = matrix
  122             queries = np.load(verify(evaluation, rec["queries"]), allow_pickle=False)
  123             assert queries.shape == (40, 28, 10)
  124             compare(queries.mean(1), matrix[:, 12:])
  125             target = reported["absolute"][point][role]
  126             for i, domain in enumerate("AB"):
  127                 audit_stats(matrix[rows[i]], target["by_domain"][domain], i, "absolute", point, role, domain)
  128             compare(matrix.mean(0), [target["macro_all"][k] for k in columns])
  129             counts = read(verify(evaluation, rec["counts"]))
  130             assert len(counts) == 40 and all(r["tp"]+r["fn"] == 20 and r["fp"]+r["tn"] == 358 for r in counts)
  131             for i, r in enumerate(counts):
  132                 tp, fp, fn, tn = (r[k] for k in ("tp", "fp", "fn", "tn"))
  133                 denom = (tp+fp)*(tp+fn)*(tn+fp)*(tn+fn)
  134                 rates = [tp/(tp+fp) if tp+fp else None, tp/20, 2*tp/(2*tp+fp+fn), tn/358,
  135                          (tp/20+tn/358)/2, (tp*tn-fp*fn)/np.sqrt(denom) if denom else None]
  136                 compare(matrix[i, 6:12], rates)
  137             c = np.asarray([[r[k] for k in ("tp", "fp", "fn", "tn")] for r in counts], np.int64)
  138             for domain, selected in [("all", np.arange(40)), ("A", rows[0]), ("B", rows[1])]:
  139                 tp, fp, fn, tn = map(int, c[selected].sum(0))
  140                 values = dict(tp=tp, fp=fp, fn=fn, tn=tn, fpr=fp/(fp+tn), recall=tp/(tp+fn),
  141                               precision=tp/(tp+fp) if tp+fp else None, f1=2*tp/(2*tp+fp+fn))
  142                 for key, value in values.items():
  143                     compare(value, target["fixed_half_classification"][domain][key])
  144                 classification[point][role][domain] = values
  145             scores = np.load(verify(run, p["scores"][role]), allow_pickle=False)
  146             assert scores.shape == (40, 378) and np.isfinite(scores).all()
  147             if role == "raw":
  148                 raw = scores
  149                 for suffix in ("raw", "calibration"):
  150                     original = np.load(verify(run, p["scores"][suffix]), allow_pickle=False)
  151                     for prefix in ("full", "inference"):
  152                         assert np.array_equal(original, np.load(verify(run, p["scores"][prefix+"-"+suffix]), allow_pickle=False))
  153             else:
  154                 affine = p["maps"]["stage" if role == "stage-cal" else "first"]
  155                 compare(scores, affine["a"] * raw.astype(np.float64) + affine["b"])
  156                 assert np.array_equal(np.argsort(raw, axis=1, kind="stable"), np.argsort(scores, axis=1, kind="stable"))
  157                 compare(matrix[:, rank_columns], matrices[point]["raw"][:, rank_columns])
  158             absolute[point][role] = {d: {k: target["by_domain"][d][k]["mean"] for k in columns} for d in "AB"}
  159         mapping = read(verify(run, p["mapping"]))
  160         assert mapping["status"] == "PASS_CALIBRATION_FIT" and mapping["optimizer_success"] and mapping["a"] > 0
  161 
  162     paired_groups = {}
  163     for candidate, other in contrasts:
  164         contrast = candidate+"-"+other
  165         paired_groups[contrast] = {}
  166         for role in roles:
  167             for stage, report_key, kind in [("B", "comparisons", "final_contrast"), ("A", "initial_comparisons", "initial_contrast")]:
  168                 delta = matrices[stage+"_"+candidate][role] - matrices[stage+"_"+other][role]
  169                 for i, domain in enumerate("AB"):
  170                     audit_stats(delta[rows[i]], reported[report_key][contrast][role][domain], i, kind, contrast, role, domain)
  171                     if stage == "B" and role == "raw":
  172                         v = delta[rows[i], columns.index("map")]
  173                         paired_groups[contrast][domain] = dict(positive=int((v > 0).sum()), negative=int((v < 0).sum()), zero=int((v == 0).sum()), values=v.tolist())
  174             delta = (matrices["A_"+candidate][role]-matrices["B_"+candidate][role]) - (matrices["A_"+other][role]-matrices["B_"+other][role])
  175             audit_stats(delta[rows[0]], reported["forgetting_comparisons"][contrast][role], 0, "forgetting_contrast", contrast, role, "A")
  176     for arm in "SGF":
  177         for role in roles:
  178             delta = matrices["B_"+arm][role] - matrices["A_"+arm][role]
  179             audit_stats(delta[rows[0]], reported["old_changes"][arm][role], 0, "old_change", arm, role, "A")
  180 
  181     training = {p: read(verify(run, manifest["training"][p])) for p in points}
  182     train_summary = {}
  183     for point, t in training.items():
  184         assert t["updates"] == 288 and [r["step"] for r in t["rows"]] == list(range(1, 289))
  185         if point.startswith("B_"):
  186             for key in ("members", "seen", "tables", "origins"):
  187                 assert t["memory_before"][key] == t["memory_after"][key]
  188             history = [r["history"] for r in t["rows"]]
  189             train_summary[point] = {"nonzero_distillation_steps": sum(r["distillation"] > 0 for r in history),
  190                 "mean_distillation": float(np.mean([r["distillation"] for r in history])),
  191                 "mean_current_supervised": float(np.mean([r["current"]["supervised"] for r in t["rows"]])),
  192                 "mean_history_supervised": float(np.mean([r["supervised"] for r in history]))}
  193         for row in t["rows"]:
  194             total = row["current"]["supervised"]
  195             if point.startswith("B_"):
  196                 h = row["history"]
  197                 total += .1*h["supervised"]+.5*h["mse0"]
  198                 np.testing.assert_allclose(h["weighted"], .1*h["supervised"]+.5*h["mse0"], rtol=2e-6, atol=2e-6)
  199             np.testing.assert_allclose(row["total"], total, rtol=2e-6, atol=2e-6)
  200         assert t["rows"][-1]["encoder_lr"] == 0 and t["rows"][-1]["head_lr"] == .001
  201     for stage in "AB":
  202         sequences = []
  203         for arm in "SGF":
  204             t = training[stage+"_"+arm]
  205             sequences.append((t["current_ids"], t["history_ids"],
  206                 [[r["current"]["assignment_sha256"], r.get("history", {}).get("assignment_sha256")] for r in t["rows"]]))
  207         assert sequences == [sequences[0]]*3
  208     solver = {}
  209     for point in ("A_F", "B_F"):
  210         s = manifest["points"][point]["solver_summary"]
  211         assert s["failures"] == 0 and s["blocks"] > 0 and s["iterations"] <= 4096
  212         assert s["feasible_error"] <= 1e-12 and s["gap_checked"] <= 5e-9
  213         assert s["ordinary_marginal_error"] <= 1e-10
  214         if s["terminal_acceptances"]:
  215             assert s["terminal_min_iteration"] == s["iterations"] == 4096 and s["marginal_error"] > 1e-10
  216         else:
  217             assert s["terminal_min_iteration"] is None and s["marginal_error"] <= 1e-10
  218         solver[point] = s
  219     terminal_steps = []
  220     previous = 0
  221     for r in training["B_F"]["rows"]:
  222         n = r["solver_summary"]["terminal_acceptances"]
  223         if n != previous:
  224             terminal_steps.append({"step": r["step"], "new_terminal_blocks": n-previous, "cumulative_terminal_blocks": n})
  225         previous = n
