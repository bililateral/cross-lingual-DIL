  227     independent_decisions, diagnostic_summary = {}, {}
  228     overfit = read(root / "diagnostics_evaluation/overfitting.json")
  229     curves, residuals, diagnostic_draws = {}, {}, {}
  230     for point in points:
  231         captures = [read(verify(run / "diagnostics", r)) for r in manifest["diagnostics"][point]]
  232         assert [d["epoch"] for d in captures] == list(range(1, 7))
  233         residuals[point] = []
  234         fits, caches, valid_metrics = [], [], []
  235         for d in captures:
  236             assert d["valid_labels_used"] is False and d["valid_ids"] == col["group_ids"]
  237             fits.append(np.load(verify(run / "diagnostics", d["fit"]), allow_pickle=False))
  238             caches.append(np.load(verify(run / "diagnostics", d["cache"]), allow_pickle=False))
  239             rec = overfit["group_metrics"][f"{point}_epoch{d['epoch']}"]
  240             valid_metrics.append(np.load(verify(root / "diagnostics_evaluation", rec), allow_pickle=False))
  241             es = d["teacher_errors"]
  242             if es:
  243                 keys = [k for k, v in es[0].items() if k != "uid" and isinstance(v, (int, float))]
  244                 residuals[point].append({"epoch": d["epoch"], **{k: float(np.mean([r[k] for r in es])) for k in keys}})
  245         for i, domain in enumerate("AB"):
  246             curves.setdefault(point, {})[domain] = np.stack(valid_metrics)[:, rows[i]].mean(1).tolist()
  247         subset = [columns.index(k) for k in ("map", "recall_at_5", "log_loss")]
  248         compare(valid_metrics[-1], matrices[point]["raw"][:, subset])
  249         last_scores = np.load(verify(run / "diagnostics", captures[-1]["valid_blind"]), allow_pickle=False)
  250         endpoint_scores = np.load(run / manifest["points"][point]["scores"]["raw"]["path"], allow_pickle=False)
  251         assert np.array_equal(last_scores, endpoint_scores)
  252         stage = 1 if point.startswith("A_") else 2
  253         for role, data, domain in [("fit", np.stack(fits), "A" if stage == 1 else "B"), ("cache", np.stack(caches), "A")]:
  254             if data.shape[1] == 0:
  255                 continue
  256             key = (stage, role, domain)
  257             if key not in diagnostic_draws:
  258                 payload = (json.dumps([20260930, "ABC", stage, role, domain, "diagnostics"], ensure_ascii=False, sort_keys=True, separators=(",", ":"), allow_nan=False) + "\n").encode()
  259                 seed = int.from_bytes(hashlib.sha256(payload).digest()[:8], "big") % (2**63-1)
  260                 generator = np.random.Generator(np.random.PCG64(seed))
  261                 diagnostic_draws[key] = (generator.integers(data.shape[1], size=(5000, data.shape[1])), generator.integers(20, size=(5000, 20)))
  262             td, vd = diagnostic_draws[key]
  263             v = np.stack(valid_metrics)[:, rows[0 if domain == "A" else 1]]
  264             signs = np.array([1., 1., -1.])
  265             target = overfit["points"][point][role][domain]
  266             compare(data.mean(1), target["train_raw_curve"])
  267             compare(v.mean(1), target["valid_raw_curve"])
  268             tb = (data[-1]-data[0])*signs
  269             vb = (v[-1]-v[0])*signs
  270             for values, draw, field in [(tb, td, "epoch1_to_6_train_benefit"), (vb, vd, "epoch1_to_6_valid_benefit")]:
  271                 compare(values.mean(0), target[field]["mean"])
  272                 compare(np.percentile(values[draw].mean(1), [2.5, 97.5], axis=0).T, target[field]["conditional_95pct_interval"])
  273             gap_draws = (data[:, td].mean(2)-v[:, vd].mean(2))*signs
  274             compare(np.percentile(gap_draws[-1]-gap_draws[0], [2.5, 97.5], axis=0).T, target["epoch1_to_6_gap_widening"]["conditional_95pct_interval"])
  275             gap = (data.mean(1)-v.mean(1))*signs
  276             gap_change = gap[-1]-gap[0]
  277             gap_ci = np.percentile(gap_draws[-1]-gap_draws[0], [2.5, 97.5], axis=0).T
  278             train_ci = np.percentile(tb[td].mean(1), [2.5, 97.5], axis=0).T
  279             valid_ci = np.percentile(vb[vd].mean(1), [2.5, 97.5], axis=0).T
  280             compare(gap, target["benefit_gap_curve"])
  281             compare(gap_change, target["epoch1_to_6_gap_widening"]["mean"])
  282             compare(np.percentile(gap_draws,[2.5,97.5],axis=1).transpose(1,2,0),target["benefit_gap_conditional_intervals"])
  283             decisions = {}
  284             for k, metric in enumerate(("map", "recall_at_5", "log_loss")):
  285                 point_signal = tb[:,k].mean() > 0 and vb[:,k].mean() < 0 and gap_change[k] > 0
  286                 supported = train_ci[k,0] > 0 and valid_ci[k,1] < 0 and gap_ci[k,0] > 0
  287                 decisions[metric] = "有相应迹象" if supported else "证据不足" if point_signal else "未见明确迹象"
  288             assert decisions == target["interpretation"]
  289             independent_decisions.setdefault(point,{})[role] = {domain:decisions}
  290             diagnostic_summary.setdefault(point,{})[role] = {"domain":domain,"train_benefit":tb.mean(0).tolist(),"valid_benefit":vb.mean(0).tolist(),"gap_widening":gap_change.tolist(),"gap_interval":gap_ci.tolist(),"interpretation":decisions}
