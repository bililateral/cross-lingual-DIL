  234 def train_stage(model, optimizer, current, memory, valid, c, arm, stage, root, budget):
  235     if parent.adam_step(optimizer) != (stage-1)*288:
  236         raise ValueError("Stage continuity differs")
  237     if memory is not None:
  238         memory.begin_stage(stage)
  239     before = None if memory is None else memory.summary()
  240     schedule, _ = parent.schedule(current, parent.contract(), method.RNG_ORDER, stage)
  241     name = "AB"[stage-1]+"_"+arm
  242     budget.phase = name
  243     rows, captures = [], []
  244     for step, group in enumerate(schedule, 1):
  245         history, target = (None, None) if memory is None else memory.draw()
  246         row = method.update(model, optimizer, group, history, target, c, arm, stage, step, budget.check)
  247         if parent.adam_step(optimizer) != (stage-1)*288+step:
  248             raise ValueError("Actual optimizer call missing")
  249         rows.append({**row, "step": step, "current_uid": group.uid, "history_uid": history.uid if history else None})
  250         if step % 48 == 0:
  251             captures.append(method.capture(model, optimizer, current, memory, valid, c, arm,
  252                 stage, step//48, root/"diagnostics", name, budget.check))
  253         if step == 1 or step % 24 == 0:
  254             print(data.json_bytes({"event": "updates", "point": name, "completed": step, **budget.snapshot()}).decode(), flush=True)
  255     after = None if memory is None else memory.summary()
  256     if before is not None and any(before[k] != after[k] for k in ("members", "seen", "origins", "tables")):
  257         raise ValueError("History targets/membership changed within B")
  258     path = root/"updates"/(name+".json")
  259     data.write_json(path, {"arm": arm, "stage": stage, "updates": 288, "adam_step": parent.adam_step(optimizer),
  260         "current_ids": [g.uid for g in schedule], "history_ids": [r["history_uid"] for r in rows if r["history_uid"]],
  261         "memory_before": before, "memory_after": after, "rows": rows})
  262     return data.record(path, root), captures
