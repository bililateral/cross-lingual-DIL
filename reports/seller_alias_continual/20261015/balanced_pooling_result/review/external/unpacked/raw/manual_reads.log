  176 def partition(groups: dict, metadata: list, c: dict) -> tuple[dict, dict]:
  177     by_id = {r["group_uid"]: r for r in metadata}
  178     fit = set()
  179     if len(groups["train"]) != 120 or len(groups["development"]) != 40:
