  210 def objective(table, group, regroup_seed, arm, reference=None, stats=None, context=None):
  211     if arm == "S":
  212         return record.objective(table, group, regroup_seed, arm, reference)
  213     if group.labels is None:
  214         raise ValueError("Authorized train labels required")
  215     slots = [record.assignment(group), record.assignment(group, regroup_seed)]
  216     context = {**(context or {}), "group_uid": group.uid}
  217     predicted = [account_logits(table, a, arm, stats, {**context, "view": "A"+str(i)}) for i, a in enumerate(slots)]
  218     truth = torch.as_tensor(group.labels, dtype=table.dtype, device=table.device)
  219     losses = [record.parent.ranking.objectives(v, truth, .5)["total"] for v in predicted]
  220     supervised = (losses[0]+losses[1])/2
  221     mse = table.new_zeros(())
  222     if reference is not None:
  223         target = torch.as_tensor(reference, dtype=table.dtype, device=table.device)
  224         mse = ((predicted[0]-account_logits(target, slots[0], arm, stats, {**context, "view": "teacher_A0"}))**2).mean()
