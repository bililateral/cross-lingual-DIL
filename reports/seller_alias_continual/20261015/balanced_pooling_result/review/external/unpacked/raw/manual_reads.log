  245 def score(model: Any, groups: list, c: dict, arm: str, check=lambda: None):
  246     if not groups:
  247         return np.empty((0, 378), np.float32)
  248     if arm == "S":
  249         return record.score(model, groups, c, check)
  250     model.eval()
