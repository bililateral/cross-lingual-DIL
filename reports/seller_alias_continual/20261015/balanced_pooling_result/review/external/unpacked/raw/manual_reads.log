  433 def solver_gate(stats: dict) -> None:
  434     """Check the recorded O/T partition; never replace raw P by rounded Q."""
  435     b, t, it = (stats.get(k) for k in ("blocks", "terminal_acceptances", "iterations"))
  436     if (any(type(v) is not int for v in (b, t, it, stats.get("failures")))
  437             or b <= 0 or not 0 <= t <= b or stats["failures"] != 0 or not 1 <= it <= 4096):
  438         raise ValueError("Missing/failed solver counts")
  439     p, q, gap = (stats.get(k) for k in ("marginal_error", "feasible_error", "gap_checked"))
  440     ordinary, terminal_min = stats.get("ordinary_marginal_error"), stats.get("terminal_min_iteration")
  441     if (any(not isinstance(v, (int, float)) or not np.isfinite(v) or v < 0 for v in (p, q, gap))
  442             or q > method.SOLVER["feasible_tolerance"] or gap > method.SOLVER["gap_tolerance"]):
  443         raise ValueError("Solver output precision differs")
  444     if b > t:
  445         if (not isinstance(ordinary, (int, float)) or not np.isfinite(ordinary)
  446                 or not 0 <= ordinary <= method.SOLVER["marginal_tolerance"] or ordinary > p):
  447             raise ValueError("Ordinary P evidence differs")
  448     elif ordinary is not None:
  449         raise ValueError("No ordinary blocks but non-null ordinary maximum")
  450     if (t == 0 and (terminal_min is not None or p > method.SOLVER["marginal_tolerance"])) or (t > 0 and (
  451             type(terminal_min) is not int or terminal_min != 4096 or it != 4096 or p <= method.SOLVER["marginal_tolerance"])):
  452         raise ValueError("Terminal acceptance iteration/P evidence differs")
  453 
