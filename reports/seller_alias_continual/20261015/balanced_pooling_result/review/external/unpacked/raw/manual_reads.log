   72     if not torch.isfinite(k).all():
   73         raise SolverFailure("Nonfinite transport input", torch.where(~torch.isfinite(k).all((1, 2)))[0], n, m, 0)
   74     mu = k.mean((1, 2))
   75     w = k-k.mean(2, keepdim=True)-k.mean(1, keepdim=True)+mu[:, None, None]
   76     kernel = w-math.log(n*m)  # tau = 1, uniform U.
   77     a, b = k.new_zeros((batch, n)), k.new_zeros((batch, m))
   78     done = torch.zeros(batch, dtype=torch.bool, device=k.device)
   79     values, plans = mu.clone(), k.new_zeros(k.shape)
   80     maxima = dict(iterations=0, marginal_error=0., feasible_error=0., gap_checked=0.,
   81                   ordinary_marginal_error=None, terminal_acceptances=0, terminal_min_iteration=None)
   82     for iteration in range(1, maximum_iterations+1):
   83         idx = torch.where(~done)[0]
   84         kw, aw, bw = kernel[idx], a[idx], b[idx]
   85         aw = -math.log(n)-torch.logsumexp(kw+bw[:, None, :], 2)
   86         bw = -math.log(m)-torch.logsumexp(kw+aw[:, :, None], 1)
   87         shift = aw.mean(1, keepdim=True)
   88         aw, bw = aw-shift, bw+shift
   89         a[idx], b[idx] = aw, bw
   90         p = (kw+aw[:, :, None]+bw[:, None, :]).exp()
   91         eps = SOLVER["roundoff_factor"]*torch.finfo(torch.float64).eps*(
   92             1+w[idx].abs().amax((1, 2))+aw.abs().amax(1)+bw.abs().amax(1))
   93         rowerr = (p.sum(2)-1/n).abs().amax(1)
   94         colerr = (p.sum(1)-1/m).abs().amax(1)
   95         q = p * torch.clamp((1/n)/p.sum(2), max=1.)[:, :, None]
   96         q = q * torch.clamp((1/m)/q.sum(1), max=1.)[:, None, :]
   97         er, ec = 1/n-q.sum(2), 1/m-q.sum(1)
   98         bad = (er < -eps[:, None]).any(1) | (ec < -eps[:, None]).any(1)
   99         if bad.any():
  100             raise SolverFailure("Negative transport rounding mass", idx[bad], n, m, iteration,
  101                                 marginal_error=torch.maximum(rowerr, colerr)[bad])
  102         er, ec = er.clamp_min(0), ec.clamp_min(0)
  103         mass = er.sum(1)
  104         q = q+er[:, :, None]*ec[:, None, :]/torch.where(mass > 0, mass, 1.)[:, None, None]
  105         primal = (q*w[idx]-torch.special.xlogy(q, q*(n*m))).sum((1, 2))
  106         dual = p.sum((1, 2))-1-aw.mean(1)-bw.mean(1)
  107         gap = dual-primal
  108         bad = (~torch.isfinite(p).all((1, 2)) | ~torch.isfinite(q).all((1, 2))
  109                | ~torch.isfinite(primal) | ~torch.isfinite(dual) | ~torch.isfinite(eps) | (q < 0).any((1, 2)))
  110         if bad.any():
  111             raise SolverFailure("Nonfinite or negative transport result", idx[bad], n, m, iteration,
  112                                 marginal_error=torch.maximum(rowerr, colerr)[bad])
  113         bad = gap < -eps
  114         if bad.any():
  115             raise SolverFailure("Transport dual bound below primal beyond roundoff", idx[bad], n, m, iteration,
  116                                 marginal_error=torch.maximum(rowerr, colerr)[bad], gap_checked=gap[bad])
  117         checked = gap.clamp_min(0)+eps
  118         feasible = torch.maximum((q.sum(2)-1/n).abs().amax(1), (q.sum(1)-1/m).abs().amax(1))
  119         marginal = torch.maximum(rowerr, colerr)
  120         qualified = (feasible <= SOLVER["feasible_tolerance"]) & (checked <= SOLVER["gap_tolerance"])
  121         ordinary = qualified & (marginal <= SOLVER["marginal_tolerance"])
  122         terminal = qualified & ~ordinary & (iteration == SOLVER["maximum_iterations"] == 4096)
  123         accept = ordinary | terminal
  124         if accept.any():
  125             finished = idx[accept]
  126             plans[finished], values[finished] = q[accept], mu[finished]+primal[accept]
  127             done[finished] = True
  128             maxima["iterations"] = iteration
  129             for name, tensor in (("marginal_error", marginal), ("feasible_error", feasible), ("gap_checked", checked)):
  130                 maxima[name] = max(maxima[name], float(tensor[accept].max()))
  131             if ordinary.any():
  132                 maxima["ordinary_marginal_error"] = max(maxima["ordinary_marginal_error"] or 0., float(marginal[ordinary].max()))
  133             if terminal.any():
  134                 maxima["terminal_acceptances"] += int(terminal.sum())
  135                 maxima["terminal_min_iteration"] = min(maxima["terminal_min_iteration"] or iteration, iteration)
  136         if done.all():
  137             if stats is not None:
  138                 stats["blocks"] = stats.get("blocks", 0)+batch
  139                 stats["failures"] = stats.get("failures", 0)
  140                 for key in ("iterations", "marginal_error", "feasible_error", "gap_checked"):
  141                     value = maxima[key]
  142                     stats[key] = max(stats.get(key, 0), value)
  143                 stats["terminal_acceptances"] = stats.get("terminal_acceptances", 0)+maxima["terminal_acceptances"]
  144                 for key, op in (("ordinary_marginal_error", max), ("terminal_min_iteration", min)):
  145                     values_to_merge = [v for v in (stats.get(key), maxima[key]) if v is not None]
  146                     stats[key] = op(values_to_merge) if values_to_merge else None
  147             return values, plans, maxima
  148     failed = ~accept
  149     raise SolverFailure(f"Transport did not converge in {maximum_iterations} full iterations", idx[failed], n, m,
  150                         maximum_iterations, marginal_error=marginal[failed], feasible_error=feasible[failed], gap_checked=checked[failed])
  151 
  152 
  153 class _Envelope(torch.autograd.Function):
  154     @staticmethod
  155     def forward(ctx, blocks, stats):
  156         values, plan, _ = solve(blocks, stats)
  157         ctx.save_for_backward(plan.to(blocks.dtype))
  158         return values.to(blocks.dtype)
  159 
  160     @staticmethod
  161     def backward(ctx, upstream):
  162         plan, = ctx.saved_tensors
  163         return upstream[:, None, None]*plan, None
