  230 def update(model, optimizer, current, history, reference, c, arm, stage, step, check=lambda: None, observe=None):
  231     stats = c.setdefault("pooling_stats", {})
  232     result = record.update(model, optimizer, current, history, reference, c, arm, RNG_ORDER,
  233         stage, step, check, observe=observe,
  234         objective_fn=lambda t, g, seed, a, ref: objective(t, g, seed, a, ref, stats,
  235             {"stage": stage, "step": step, "role": "current" if ref is None else "history"}))
  236     for role, g in (("current", current), ("history", history)):
  237         if g is not None:
  238             key = data.seed_for(20260918, RNG_ORDER, stage, step, role, g.uid, "regroup")
  239             result[role]["assignment_sha256"] = hashlib.sha256(record.assignment(g, key).tobytes()).hexdigest()
  240     result["pooling"] = identity(arm)
  241     result["solver_summary"] = stats.copy()
