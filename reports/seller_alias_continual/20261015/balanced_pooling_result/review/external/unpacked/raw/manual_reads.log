  184             raise ValueError("Current domain count differs")
  185         ids.sort(key=lambda u: hashlib.sha256(data.json_bytes([c["partition"]["seed"], domain, u])).hexdigest())
  186         fit.update(ids[:48])
  187     selected = {"fit": [g for g in groups["train"] if g.uid in fit],
  188                 "calibration": [g for g in groups["train"] if g.uid not in fit], "development": groups["development"]}
  189     rows = {k: [{"group_uid": g.uid, "domain": by_id[g.uid]["domain"]} for g in v] for k, v in selected.items()}
  190     if len({r["group_uid"] for v in rows.values() for r in v}) != 160:
  191         raise ValueError("Partition has duplicate/cross-role groups")
  192     for role, n in (("fit", 48), ("calibration", 12), ("development", 20)):
  193         if any(sum(r["domain"] == d for r in rows[role]) != n for d in "AB"):
  194             raise ValueError("AB per-role coverage differs")
  195     return selected, rows
