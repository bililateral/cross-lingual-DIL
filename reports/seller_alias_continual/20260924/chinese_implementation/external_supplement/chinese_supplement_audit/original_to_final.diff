+def fixed_classification(counts: list[dict], domains: list[str]) -> dict:
+    """Sum saved per-group confusion counts before calculating classification rates."""
+    values = np.asarray([[row[key] for key in ("tp", "fp", "fn", "tn")]
+                         for row in counts], dtype=np.int64)
+    if values.shape != (len(domains), 4) or set(domains) != set("ABC") or np.any(values < 0):
+        raise ValueError("Invalid saved confusion counts/domain alignment")
+    return {"threshold": 0.0, "pooled": rates(values),
+            "by_domain": {d: rates(values[np.asarray(domains) == d]) for d in "ABC"},
+            "aggregation": "Sum confusion counts before computing rates; distinct from mean per-group metrics."}
+
