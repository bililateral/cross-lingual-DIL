+            evidence.append(dict(dtype=str(dtype),reference_value=ref,reference_plan=refp.tolist(),value=float(values[0]),
+                plan=q[0].tolist(),actual_vjp=gradient.tolist(),upstream=upstream.tolist(),stats=info,
