{
  "version": "2026-07-16-step22-v1-same-seller-item-split",
  "objective": "Evaluate whether identifier-redacted, item-disjoint pseudo-alias views from real Chinese sellers improve train-only identity learning beyond equal-effective-weight duplication.",
  "inputs": {
    "item_manifest": "reports/step2_content_item_manifest.csv",
    "market_item_workbook": "market_item.xlsx",
    "frozen_labels": "reports/step5_zh_target_strict_frozen_silver_labels.csv",
    "evidence_labels": "reports/step15_evidence_type_labels.zh_target_strict.csv",
    "item_identity_signals": "reports/step3_item_identity_signals.zh_target_strict.csv",
    "component_assignments": "reports/step16i_data_integrity/step16i_integrity_20260716_v2/component_assignments.csv",
    "permanent_exclusions": "reports/step16i_data_integrity/step16i_integrity_20260716_v2/permanent_exclusion_manifest.csv",
    "v7_policy": "schema/step15_v7_two_stage_policy.json",
    "semantic_model_policy": "schema/step7_semantic_model_policy.json"
  },
  "outputs_root": "reports/step22_same_seller_split/v1_20260716",
  "global_seed": 20260716,
  "eligibility": {
    "required_data_bucket": "zh_target_strict",
    "required_source_dataset": "market_item.xlsx",
    "excluded_canonical_splits": ["valid", "test"],
    "minimum_source_items": 6,
    "minimum_unique_content_groups": 6,
    "minimum_items_per_positive_view": 3,
    "minimum_content_groups_per_positive_view": 3,
    "maximum_content_groups_per_positive_parent": 12,
    "minimum_items_per_negative_view": 3,
    "minimum_content_groups_per_negative_view": 3,
    "maximum_content_groups_per_negative_view": 6,
    "maximum_positive_parent_sellers": 0,
    "maximum_negative_parent_pairs": 0,
    "require_reviewed_negative_train_parent": true,
    "require_negative_parent_usable_for_supervision": true,
    "require_negative_parent_usable_for_core_transfer": true
  },
  "generation": {
    "partition_strategy": "content_signature_grouped_category_stratified_disjoint",
    "identifier_redaction_required": true,
    "forbid_exact_title_overlap_between_positive_views": true,
    "forbid_exact_description_overlap_between_positive_views": true,
    "fabricate_identifiers": false,
    "fabricate_market_provenance": false,
    "synthetic_market_marker": "SYNTHETIC_TRAIN_ONLY",
    "synthetic_uid_prefix": "synthetic://step22/v1",
    "profile_text_fields": ["category_concat_top", "title_concat_top", "description_concat_top"],
    "profile_text_item_limit": 12
  },
  "weighting": {
    "positive_synthetic_budget_fraction_of_real_zh_positive_weight": 0.5,
    "negative_synthetic_budget_fraction_of_real_zh_negative_weight": 0.25,
    "equal_effective_weight_duplication_controls_required": true,
    "standardization_reference": "real_train_rows_only",
    "sample_weight_total_normalization": "real_train_row_count"
  },
  "evaluation": {
    "experiments": [
      "no_augmentation",
      "equal_weight_duplication_positive_budget",
      "same_seller_split_positive_only",
      "equal_weight_duplication_full_budget",
      "same_seller_split_plus_reviewed_negative_views"
    ],
    "representation": "identifier_redacted_e5_cosine_plus_fixed_64d_symmetric_pair_projection",
    "selection_scope": "five_fold_grouped_oof_on_canonical_chinese_train_components_only",
    "selection_metric": "average_precision",
    "fold_count": 5,
    "fold_seed": 20260716,
    "forbid_valid_or_test_selection": true,
    "minimum_ap_gain_over_no_augmentation": 0.01,
    "minimum_ap_gain_over_matched_duplication": 0.01,
    "final_holdout": "Step20 genuinely prospective real data only"
  },
  "outputs": {
    "summary": "step22_generation_summary.json",
    "manifest": "step22_generation_manifest.json",
    "profiles": "pseudo_seller_profiles.jsonl",
    "pair_labels": "pseudo_pair_labels.csv",
    "pair_lineage": "pseudo_pair_lineage.csv",
    "item_lineage": "pseudo_item_lineage.csv",
    "embedding_matrix": "pseudo_e5_identifier_redacted.npy",
    "embedding_metadata": "pseudo_e5_identifier_redacted.json",
    "evaluation_summary": "step22_grouped_oof_evaluation.json",
    "evaluation_predictions": "step22_grouped_oof_predictions.csv",
    "sync_manifest": "step22_sync_manifest.json"
  },
  "scientific_constraints": [
    "A pseudo-alias positive proves only that two disjoint item views came from one observed seller account; it is not a newly observed cross-account sockpuppet relation.",
    "Synthetic rows are training-only and never enter Step5, zh_valid, zh_test, Step16I Dev2, Step20, Step11, or Step17.",
    "The independent unit for pseudo-positive resampling is the real source seller, never the number of generated profiles or pair rows.",
    "Reviewed hard-negative views inherit an existing canonical train negative and its recomputed seller component.",
    "All source sellers touching canonical valid/test by seller UID or portable alias are excluded before generation.",
    "A gain is not attributed to representation augmentation unless it exceeds both no augmentation and its equal-effective-weight duplication control.",
    "No current valid/test score is used to select generation rules, weight budgets, representation, or model family."
  ]
}
