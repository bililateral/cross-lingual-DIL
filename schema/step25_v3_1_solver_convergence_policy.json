{
  "version": "2026-07-18-step25-v3-1-kkt-solver-convergence-repair",
  "objective": "Repeat the frozen Step25-v3 C0-C3 experiment after repairing only the constrained LR/L2 termination contract; no feature, weight, fold, model, gate or scientific claim may change.",
  "base_policy": "schema/step25_v3_copy_aware_dual_channel_policy.json",
  "outputs_root": "reports/step25_template_decontaminated_authorship/v3_1_solverfix_20260718",
  "solver_repair": {
    "solver": "active_set_projected_newton_logistic_l2_with_backtracking_kkt_fail_closed",
    "projected_gradient_tolerance": 1e-08,
    "relative_loss_diagnostic_tolerance": 1e-08,
    "relative_loss_is_a_convergence_criterion": false,
    "maximum_iterations": 10000,
    "minimum_step_size": 1e-12,
    "backtracking_factor": 0.5,
    "armijo_constant": 0.0001,
    "non_kkt_stagnation_action": "fail_closed",
    "required_artifact_fields": [
      "solver_termination_reason",
      "solver_final_objective",
      "solver_final_gradient_infinity_norm",
      "solver_final_projected_gradient",
      "solver_final_relative_loss",
      "solver_final_accepted_step_size"
    ]
  },
  "scientific_freeze": {
    "feature_contract_identical_to_base_v3": true,
    "model_specs_identical_to_base_v3": true,
    "factorized_sample_weights_identical_to_base_v3": true,
    "component_fold_assignments_identical_to_base_v3": true,
    "l2_penalty_identical_to_base_v3": true,
    "class_weight_identical_to_base_v3": true,
    "bootstrap_configuration_identical_to_base_v3": true,
    "d0_to_d1_gates_identical_to_base_v3": true,
    "valid_or_test_access_forbidden": true,
    "model_or_threshold_selection_forbidden": true,
    "old_v3_outputs_overwrite_forbidden": true,
    "publication_promotion_hard_false": true,
    "step11_or_step17_entry_forbidden": true
  },
  "outputs": {
    "pair_features_en": "step25_v3_1_pair_features.en_content_train_pool.csv",
    "pair_features_zh": "step25_v3_1_pair_features.zh_target_strict.csv",
    "pair_feature_summary": "step25_v3_1_pair_feature_summary.json",
    "predictions_en": "step25_v3_1_grouped_oof_predictions.en.csv",
    "predictions_zh": "step25_v3_1_grouped_oof_predictions.zh.csv",
    "model_artifacts": "step25_v3_1_model_artifacts.json",
    "evaluation_summary": "step25_v3_1_evaluation_summary.json",
    "operational_predictions_zh": "step25_v3_1_operational_identifier_control.zh.csv",
    "operational_summary": "step25_v3_1_operational_identifier_control_summary.json",
    "sync_manifest": "step25_v3_1_sync_manifest.json"
  }
}
