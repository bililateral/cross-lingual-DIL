{
  "version": "2026-07-06-silver-positive-train-expansion",
  "objective": "Expand zh_target_strict positive training supervision with weakly supervised silver_train_only pairs while keeping existing validation/test splits unchanged.",
  "inputs": {
    "frozen_labels": "reports/step5_zh_target_strict_frozen_silver_labels.csv",
    "candidate_pairs": "reports/step4_zh_target_strict_silver_candidate_pairs.csv",
    "pair_features": "reports/step7_pair_features.zh_target_strict.csv"
  },
  "outputs": {
    "expanded_frozen_labels": "reports/step5_zh_target_strict_frozen_silver_labels.csv",
    "candidate_audit_csv": "reports/step16b_silver_positive_candidate_pairs.csv",
    "applied_training_pairs_csv": "reports/step16b_silver_positive_training_pairs.csv",
    "summary_json": "reports/step16b_silver_positive_expansion_summary.json"
  },
  "selection": {
    "target_additional_positive_train_rows": 180,
    "exclude_existing_positive_negative": true,
    "allow_existing_uncertain": true,
    "candidate_scope": "sockpuppet_primary",
    "candidate_language": "zh",
    "split_name": "train",
    "exclude_valid_test_seller_overlap": true,
    "silver_component_closure": {
      "enabled": true,
      "max_rows": 80,
      "require_pair_feature_row": true
    },
    "weak_positive_rules": {
      "shared_contact_weak": {
        "enabled": true,
        "min_shared_contact_count": 1,
        "min_structural_support_score": 0.15,
        "min_lexical_similarity_fallback": 0.1,
        "min_shared_text_overlap_fallback": 1
      },
      "template_structural_weak": {
        "enabled": true,
        "min_shared_title_count": 1,
        "min_shared_description_count": 1,
        "min_structural_support_score": 0.28,
        "min_lexical_similarity": 0.35
      },
      "clone_overlap_weak": {
        "enabled": true,
        "min_shared_title_count": 2,
        "min_shared_description_count": 2,
        "min_structural_support_score": 0.2
      },
      "high_similarity_weak": {
        "enabled": true,
        "min_lexical_similarity": 0.68,
        "min_structural_support_score": 0.38,
        "min_shared_signal_count": 1
      },
      "rank_structural_weak": {
        "enabled": true,
        "min_candidate_rank_score": 10.0,
        "min_structural_support_score": 0.42,
        "min_lexical_similarity": 0.35
      }
    }
  },
  "training_weights": {
    "gold_existing": 1.0,
    "silver_direct_or_contact": 0.55,
    "silver_template_structural": 0.4,
    "silver_component_closure": 0.25
  },
  "safety_rules": [
    "Do not modify existing validation/test rows.",
    "Do not add any silver_train_only pair if either seller appears in current zh_valid or zh_test supervision.",
    "Do not convert existing reviewed negative rows into positive.",
    "All added rows must be train-only and must carry reviewer_id=step16b_silver_positive_expansion_20260706.",
    "Silver labels are weak training supervision, not gold benchmark truth."
  ]
}
