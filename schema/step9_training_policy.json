          "recall",
          "precision",
          "specificity",
          "lower_threshold"
        ]
      },
      "bootstrap": {
        "num_resamples": 200,
        "aggregation": "median",
        "minimum_unique_thresholds_for_non_fallback": 3
      }
    },
    "low_ratio_guard": {
      "enabled": true,
      "max_ratio": 0.2,
      "max_sampled_target_train_rows": 40,
      "fixed_tree_training": {
        "num_boost_round": 160,
        "disable_early_stopping": true,
        "lightgbm_param_overrides": {
          "learning_rate": 0.03,
          "feature_fraction": 0.6,
          "bagging_fraction": 0.8
        },
        "post_train_iteration_scan": {
          "enabled": true,
          "min_best_iteration": 8,
          "min_unique_valid_probabilities": 6,
          "probability_round_decimals": 6,
          "selection": {
