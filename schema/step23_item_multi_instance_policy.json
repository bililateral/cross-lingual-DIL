{
  "version": "2026-07-17-step23-v2-matched-item-controls",
  "objective": "Test whether identifier-redacted distributions over real item-to-item relations add identity signal beyond a matched aggregate built from the exact same selected real items.",
  "outputs_root": "reports/step23_item_multi_instance/v2_20260717",
  "inputs": {
    "item_manifest": "reports/step2_content_item_manifest.csv",
    "market_item_workbook": "market_item.xlsx",
    "agora_workbook": "2017-12-05-philipjames11-darknetmarketplacedataagora20142015.xlsx",
    "component_assignments": "reports/step16i_data_integrity/step16i_integrity_20260716_v2/component_assignments.csv",
    "v7_policy": "schema/step15_v7_two_stage_policy.json",
    "semantic_model_policy": "schema/step7_semantic_model_policy.json"
  },
  "pools": {
    "en_content_train_pool": {
      "domain": "en",
      "frozen_labels": "reports/step5_en_frozen_silver_labels.csv",
      "evidence_labels": "reports/step15_evidence_type_labels.en_content_train_pool.csv",
      "seller_profiles": "reports/step3_seller_profiles.en_content_train_pool.jsonl",
      "item_identity_signals": "reports/step3_item_identity_signals.en_content_train_pool.csv"
    },
    "zh_target_strict": {
      "domain": "zh",
      "frozen_labels": "reports/step5_zh_target_strict_frozen_silver_labels.csv",
      "evidence_labels": "reports/step15_evidence_type_labels.zh_target_strict.csv",
      "seller_profiles": "reports/step3_seller_profiles.zh_target_strict.jsonl",
      "item_identity_signals": "reports/step3_item_identity_signals.zh_target_strict.csv"
    }
  },
  "item_selection": {
    "allowed_split": "train",
    "require_usable_for_supervision": true,
    "allowed_review_labels": ["positive", "negative"],
    "maximum_items_per_seller": 12,
    "minimum_nonempty_items_per_seller": 1,
    "maximum_clean_text_characters": 2000,
    "strategy": "seller_local_exact_content_dedup_then_category_round_robin",
    "selection_uses_labels": false,
    "selection_uses_cross_seller_statistics": false,
    "text_fields": ["category", "title", "description"],
    "exclude_fields": ["seller_alias", "market", "contact", "structured_snapshot"],
    "identifier_redaction_required": true,
    "empty_text_fallback": "content unavailable"
  },
  "embedding": {
    "model_key": "multilingual_e5_large",
    "batch_source": "selected_real_train_items_only",
    "identifier_redacted": true,
    "valid_test_items_encoded": false
  },
  "multi_instance_features": {
    "cosine_distribution_quantiles": [0.25, 0.5, 0.75, 0.9, 0.95],
    "nearest_neighbor_quantiles": [0.25, 0.5, 0.75],
    "top_k_means": [1, 3, 5],
    "include_mutual_top1_share": true,
    "include_exact_redacted_title_overlap": true,
    "include_exact_redacted_description_overlap": true,
    "include_category_jaccard": true,
    "include_best_match_style_gaps": true,
    "style_fields": ["length_log", "digit_ratio", "punct_ratio", "cjk_ratio"],
    "forbid_identifier_features": true,
    "forbid_global_idf_or_test_fitted_statistics": true
  },
  "evaluation": {
    "model_feature_sets": {
      "same_item_mean_pool_cosine_only": [
        "mi_mean_pool_cosine"
      ],
      "item_structure_only": [
        "mi_item_count_min",
        "mi_item_count_max",
        "mi_item_count_log_gap",
        "mi_cross_pair_count_log",
        "mi_exact_title_intersection",
        "mi_exact_title_jaccard",
        "mi_exact_description_intersection",
        "mi_exact_description_jaccard",
        "mi_category_jaccard"
      ],
      "same_item_aggregate_control": [
        "mi_mean_pool_cosine",
        "mi_item_count_min",
        "mi_item_count_max",
        "mi_item_count_log_gap",
        "mi_cross_pair_count_log",
        "mi_exact_title_intersection",
        "mi_exact_title_jaccard",
        "mi_exact_description_intersection",
        "mi_exact_description_jaccard",
        "mi_category_jaccard"
      ],
      "semantic_distribution_no_count": [
        "mi_cosine_mean",
        "mi_cosine_std",
        "mi_cosine_min",
        "mi_cosine_max",
        "mi_nn_mean",
        "mi_nn_std",
        "mi_nn_min",
        "mi_nn_max",
        "mi_nn_side_mean_abs_gap",
        "mi_mutual_top1_share",
        "mi_cosine_q25",
        "mi_cosine_q50",
        "mi_cosine_q75",
        "mi_cosine_q90",
        "mi_cosine_q95",
        "mi_nn_q25",
        "mi_nn_q50",
        "mi_nn_q75",
        "mi_cosine_top1_mean",
        "mi_cosine_top3_mean",
        "mi_cosine_top5_mean",
        "mi_cosine_max_minus_median",
        "mi_cosine_q95_minus_median",
        "mi_best_match_length_log_gap_mean",
        "mi_best_match_length_log_gap_max",
        "mi_best_match_digit_ratio_gap_mean",
        "mi_best_match_digit_ratio_gap_max",
        "mi_best_match_punct_ratio_gap_mean",
        "mi_best_match_punct_ratio_gap_max",
        "mi_best_match_cjk_ratio_gap_mean",
        "mi_best_match_cjk_ratio_gap_max"
      ],
      "aggregate_plus_distribution_primary": [
        "mi_mean_pool_cosine",
        "mi_item_count_min",
        "mi_item_count_max",
        "mi_item_count_log_gap",
        "mi_cross_pair_count_log",
        "mi_exact_title_intersection",
        "mi_exact_title_jaccard",
        "mi_exact_description_intersection",
        "mi_exact_description_jaccard",
        "mi_category_jaccard",
        "mi_cosine_mean",
        "mi_cosine_std",
        "mi_cosine_min",
        "mi_cosine_max",
        "mi_nn_mean",
        "mi_nn_std",
        "mi_nn_min",
        "mi_nn_max",
        "mi_nn_side_mean_abs_gap",
        "mi_mutual_top1_share",
        "mi_cosine_q25",
        "mi_cosine_q50",
        "mi_cosine_q75",
        "mi_cosine_q90",
        "mi_cosine_q95",
        "mi_nn_q25",
        "mi_nn_q50",
        "mi_nn_q75",
        "mi_cosine_top1_mean",
        "mi_cosine_top3_mean",
        "mi_cosine_top5_mean",
        "mi_cosine_max_minus_median",
        "mi_cosine_q95_minus_median",
        "mi_best_match_length_log_gap_mean",
        "mi_best_match_length_log_gap_max",
        "mi_best_match_digit_ratio_gap_mean",
        "mi_best_match_digit_ratio_gap_max",
        "mi_best_match_punct_ratio_gap_mean",
        "mi_best_match_punct_ratio_gap_max",
        "mi_best_match_cjk_ratio_gap_mean",
        "mi_best_match_cjk_ratio_gap_max"
      ]
    },
    "primary_model": "aggregate_plus_distribution_primary",
    "matched_baseline_model": "same_item_aggregate_control",
    "primary_model_preregistered": true,
    "candidate_selection_forbidden": true,
    "source_only_controls_required_for_every_model": true,
    "target_oof_training": "all_english_train_plus_four_fifths_chinese_train",
    "fold_count": 5,
    "fold_seed": 20260716,
    "development_metric": "average_precision",
    "development_scope": "seller_component_grouped_oof_on_canonical_chinese_train_only",
    "valid_or_test_selection_forbidden": true,
    "grouped_bootstrap_resamples": 5000,
    "grouped_bootstrap_seed": 20260716,
    "minimum_ap_gain_over_matched_aggregate": 0.02,
    "minimum_bootstrap_lower_bound": 0.0,
    "minimum_non_silver_ap_delta": 0.0,
    "minimum_strong_evidence_ap_delta": 0.0,
    "minimum_direct_component_positive_mean_score_delta": -0.02,
    "maximum_template_or_topic_mean_score_increase": 0.02,
    "maximum_template_or_topic_q95_score_increase": 0.02,
    "maximum_template_or_topic_top_decile_mean_score_increase": 0.02,
    "silver_metrics_secondary_only": true,
    "promotion_scope": "internal_development_only_not_a_publication_claim",
    "frozen_scorer_requires_promotion": true,
    "publication_holdout": "Step20 genuinely prospective real data only"
  },
  "outputs": {
    "selected_items": "selected_identifier_redacted_items.jsonl",
    "item_selection_summary": "item_selection_summary.json",
    "item_selection_manifest": "item_selection_manifest.json",
    "item_embedding_matrix": "selected_item_e5.npy",
    "item_embedding_metadata": "selected_item_e5.json",
    "pair_features_en": "pair_features.en_content_train_pool.csv",
    "pair_features_zh": "pair_features.zh_target_strict.csv",
    "pair_feature_summary": "pair_feature_summary.json",
    "oof_predictions": "step23_grouped_oof_predictions.csv",
    "evaluation_summary": "step23_grouped_oof_evaluation.json",
    "model_artifacts": "step23_model_artifacts.json",
    "sync_manifest": "step23_sync_manifest.json"
  },
  "scientific_constraints": [
    "Step23 creates no synthetic labels, sellers, items or identity relations.",
    "Only canonical train sellers and real source items may enter the item cache.",
    "Item selection is seller-local and label-blind; valid/test sellers and their items are never encoded.",
    "All train-fitted imputation, scaling and model coefficients are refit inside each seller-component fold.",
    "English rows are source supervision; Chinese held-out components are never present in a fold's training rows.",
    "The preregistered primary is compared only with an aggregate control built from the exact same selected real items.",
    "Promotion requires improvement over the matched aggregate control and must not be obtained by raising the mean or high-score tail of template/topic negatives.",
    "Silver-label metrics are secondary development evidence; non-silver and direct/component sensitivities must not regress.",
    "Current valid/test and Step16I Dev2 cannot be used to choose item caps, features, regularization or promotion thresholds."
  ]
}
