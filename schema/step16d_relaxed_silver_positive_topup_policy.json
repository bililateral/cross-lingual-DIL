{
  "version": "2026-07-09-relaxed-silver-positive-topup",
  "objective": "Top up zh_target_strict train-only weak positive supervision until the current training split is class-balanced, without adding negatives unless positives exceed negatives.",
  "inputs": {
    "frozen_labels": "reports/step5_zh_target_strict_frozen_silver_labels.csv",
    "candidate_pairs": "reports/step4_zh_target_strict_silver_candidate_pairs.csv",
    "pair_features": "reports/step7_pair_features.zh_target_strict.csv",
    "planned_refreeze_plan": "reports/step16c_gold_valid_test_refreeze_plan.csv"
  },
  "outputs": {
    "expanded_frozen_labels": "reports/step5_zh_target_strict_frozen_silver_labels.csv",
    "candidate_audit_csv": "reports/step16d_relaxed_silver_positive_topup_candidates.csv",
    "applied_training_pairs_csv": "reports/step16d_relaxed_silver_positive_topup_training_pairs.csv",
    "summary_json": "reports/step16d_relaxed_silver_positive_topup_summary.json"
  },
  "selection": {
    "target_mode": "balance_current_train_positive_to_negative",
    "max_additional_positive_train_rows": 60,
    "candidate_scope": "sockpuppet_primary",
    "candidate_language": "zh",
    "exclude_current_valid_test_seller_overlap": true,
    "exclude_planned_valid_test_seller_overlap": true,
    "exclude_existing_positive_negative": true,
    "allow_existing_uncertain": true,
    "require_pair_feature_row": true,
    "relaxed_positive_rules": {
      "silver_high_similarity_relaxed": {
        "enabled": true,
        "min_lexical_similarity": 0.78,
        "min_structural_support_score": 0.2,
        "min_shared_signal_count": 1,
        "training_sample_weight": 0.24
      },
      "silver_template_structural_relaxed": {
        "enabled": true,
        "min_shared_title_count": 1,
        "min_shared_description_count": 1,
        "min_structural_support_score": 0.2,
        "min_lexical_similarity": 0.28,
        "training_sample_weight": 0.2
      },
      "silver_clone_overlap_relaxed": {
        "enabled": true,
        "min_shared_title_count": 2,
        "min_shared_description_count": 1,
        "min_structural_support_score": 0.12,
        "training_sample_weight": 0.18
      },
      "silver_rank_structural_relaxed": {
        "enabled": true,
        "min_candidate_rank_score": 8.0,
        "min_structural_support_score": 0.3,
        "min_lexical_similarity": 0.28,
        "training_sample_weight": 0.18
      }
    }
  },
  "safety_rules": [
    "All added rows must be positive train-only weak supervision.",
    "No relaxed silver row may enter validation or test.",
    "No existing positive or negative row may be converted.",
    "Existing uncertain rows may only be converted to train-only silver positive with benchmark_eligible=0.",
    "Rows overlapping current valid/test sellers are forbidden.",
    "Rows overlapping Step16C planned valid/test sellers are forbidden when a Step16C plan exists.",
    "Every selected row must already have Step7 pair features.",
    "Relaxed positives are weak training support, not gold benchmark truth."
  ]
}
