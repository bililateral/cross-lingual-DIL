{
  "version": "2026-07-13-step20-prospective-candidate-v1",
  "description": "Required score-blind fields for post-Step15-v7 Chinese prospective holdout candidate collection.",
  "required_non_empty_fields": [
    "pair_uid",
    "seller_uid_left",
    "seller_uid_right",
    "collection_timestamp_utc",
    "language_code",
    "source_domain",
    "source_collection_id",
    "source_record_id_left",
    "source_record_id_right",
    "source_provenance_ref_left",
    "source_provenance_ref_right",
    "source_content_sha256_left",
    "source_content_sha256_right",
    "source_market_raw_left",
    "source_market_raw_right",
    "source_seller_raw_left",
    "source_seller_raw_right",
    "left_preview",
    "right_preview"
  ],
  "required_present_fields": [
    "review_status",
    "review_stratum",
    "shared_contact_values",
    "shared_pgp_fingerprint_values",
    "shared_title_values",
    "shared_description_values"
  ],
  "timestamp_contract": {
    "field": "collection_timestamp_utc",
    "must_include_timezone": true,
    "must_be_strictly_after_model_freeze": true
  },
  "source_contract": {
    "language_code_allowed": ["zh"],
    "source_domain_allowed": [
      "chinese_darknet_market",
      "chinese_underground_marketplace"
    ],
    "content_sha256_fields": [
      "source_content_sha256_left",
      "source_content_sha256_right"
    ],
    "content_sha256_regex": "^[0-9a-f]{64}$"
  },
  "forbidden_fields": [
    "prior_review_label",
    "model_score",
    "step9_score",
    "step15_score",
    "step17_score",
    "graph_membership",
    "candidate_rank_score"
  ]
}
