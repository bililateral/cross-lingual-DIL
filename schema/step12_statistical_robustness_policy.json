{
  "version": "2026-05-14",
  "objective": "Fixed zh_test statistical robustness audit for current-boundary Step 7 and Step 9 scorers using grouped bootstrap confidence intervals and paired bootstrap comparisons.",
  "scope": "zh_target_strict fixed test split only",
  "input_dependencies": [
    "reports/step5_zh_target_strict_frozen_silver_labels.csv",
    "reports/step7_pair_features.zh_target_strict.csv",
    "reports/step7_training_summary.json",
    "reports/step9_few_shot_summary.json"
  ],
  "fixed_test_policy": {
    "split_name": "test",
    "labels": [
      "positive",
      "negative"
    ],
    "do_not_mix_train_valid_test": true,
    "grouping_unit": "split_component_id",
    "note": "The robustness audit keeps the current fixed zh_test benchmark. It does not replace the frozen test split with random K-fold CV."
  },
  "bootstrap": {
    "num_resamples": 5000,
    "confidence_level": 0.95,
    "random_seed": 20260513,
    "resample_unit": "split_component_id",
    "skip_resamples_without_both_classes": true
  },
  "metrics": [
    "roc_auc",
    "average_precision"
  ],
  "model_set": {
    "raw_semantic_controls": [
      "raw_e5_cosine",
      "raw_labse_cosine",
      "raw_bge_m3_cosine"
    ],
    "step7_controls": [
      "step7_core_zero_shot_default",
      "step7_core_zero_shot_bge_m3",
      "step7_core_zero_shot_default_no_structural",
      "step7_identifier_augmented_default"
    ],
    "step9_clean_current": [
      "step9_e5_lr_l2_50pct_seed_20260320",
      "step9_e5_lr_l2_50pct_seed_20260321",
      "step9_e5_lr_l2_50pct_seed_20260322",
      "step9_e5_lr_l2_50pct_seed_mean",
      "step9_e5_lr_l2_positive_pair_mixup_50pct_seed_20260320",
      "step9_e5_lr_l2_positive_pair_mixup_50pct_seed_20260321",
      "step9_e5_lr_l2_positive_pair_mixup_50pct_seed_20260322",
      "step9_e5_lr_l2_positive_pair_mixup_50pct_seed_mean",
      "step9_e5_lr_l2_positive_pair_mixup_100pct_seed_20260320",
      "step9_e5_lr_l2_positive_pair_mixup_100pct_seed_20260321",
      "step9_e5_lr_l2_positive_pair_mixup_100pct_seed_20260322",
      "step9_e5_lr_l2_positive_pair_mixup_100pct_seed_mean",
      "step9_bge_m3_residual_lr_100pct_seed_mean",
      "step9_labse_lr_l2_100pct_seed_mean"
    ],
    "step9_operational_control": [
      "step9_identifier_augmented_lr_l2_100pct_seed_mean"
    ]
  },
  "paired_comparison_policy": {
    "primary_baseline": "raw_e5_cosine",
    "must_compare_against_raw_semantic": true,
    "must_compare_against_step7_collapsed_fusion": true,
    "p_value": "Two-sided bootstrap sign probability over grouped resamples; descriptive only, not a formal DeLong test."
  },
  "outputs": {
    "summary_json": "reports/step12_statistical_robustness_zh_test_20260513.json",
    "model_metrics_csv": "reports/step12_statistical_robustness_model_metrics_20260513.csv",
    "paired_comparisons_csv": "reports/step12_statistical_robustness_paired_comparisons_20260513.csv"
  },
  "hard_rules": [
    "Do not merge zh_train, zh_valid, and zh_test for the primary robustness audit.",
    "Do not use this audit to relabel Step 5 rows.",
    "Do not report few-shot improvement without paired comparison against raw semantic baselines.",
    "Positive-pair mixup rows are training-only minority regularization artifacts and must be evaluated against both raw semantic controls and the non-mixup E5 LR/L2 baseline.",
    "Identifier-augmented models remain operational controls and must not be mixed into the clean scientific claim."
  ]
}
