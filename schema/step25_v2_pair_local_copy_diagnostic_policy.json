{
  "version": "2026-07-17-step25-v2-preregistered-pair-local-copy-missingness-diagnostic",
  "objective": "Diagnose whether Step25-v1 failed because global template support missed pair-local copied spans and because unreliable cleaned style was encoded as a real zero cosine.",
  "outputs_root": "reports/step25_template_decontaminated_authorship/v2_pair_local_diagnostic_20260717",
  "inputs": {
    "step24_policy": "schema/step24_content_independent_authorship_policy.json",
    "step24_outputs_root": "reports/step24_content_independent_authorship/v1_20260717",
    "step25_v1_policy": "schema/step25_template_decontaminated_authorship_policy.json",
    "step25_v1_outputs_root": "reports/step25_template_decontaminated_authorship/v1_20260717",
    "v7_policy": "schema/step15_v7_two_stage_policy.json"
  },
  "boundary": {
    "name": "d0_current_canonical_train",
    "role": "post_step25_v1_mechanism_diagnostic_only",
    "hypothesis_informed_retrospective": true,
    "labels_may_be_used_for_grouped_oof_fitting": true,
    "valid_or_test_read_forbidden": true,
    "d1_candidate_eligibility_hard_false": true,
    "publication_promotion_hard_false": true,
    "step11_or_step17_entry_forbidden": true,
    "parameter_search_on_d0_forbidden": true
  },
  "clean_text_contract": {
    "source": "step15_v7_identifier_redacted_clean_text_exact_replay",
    "text_fields": [
      "category_concat_top",
      "signature_title_concat",
      "title_concat_top",
      "signature_description_concat",
      "description_concat_top"
    ],
    "excluded_profile_fields": [
      "source_seller_raw",
      "alias_normalized",
      "source_market_raw",
      "source_seller_id_raw",
      "contact_concat_top",
      "structured_snapshot_concat_top",
      "profile_text"
    ],
    "redaction_sources": "step3_item_identity_occurrences_plus_high_precision_identifier_regexes",
    "require_exact_v7_corpus_hash_replay": true,
    "encode_split": "train",
    "encode_valid_or_test": false,
    "empty_text_fallback": "content unavailable"
  },
  "pair_local_copy_detector": {
    "label_free": true,
    "pair_local_only": true,
    "global_document_frequency_required": false,
    "unicode_normalization": "NFKC",
    "casefold": true,
    "collapse_whitespace": true,
    "character_shingle_length": 12,
    "minimum_contiguous_mask_characters": 24,
    "minimum_reliable_remaining_content_characters": 32,
    "maximum_mask_fraction_per_side": 0.95,
    "minimum_alphanumeric_fraction_per_shingle": 0.5,
    "mask_both_sides_symmetrically": true,
    "persist_raw_shared_span_text": false,
    "persist_shared_shingle_hashes_only": true,
    "labels_evidence_types_scores_and_split_metrics_forbidden": true,
    "detector_parameter_search_forbidden": true
  },
  "frozen_style_encoders": {
    "pcm_multilingual_authorship": {
      "repo_id": "Blablablab/multilingual-style-representation",
      "revision": "b0147bbf450424fe72c8525fcc02e2e39e3a4024",
      "local_path": "models/step24/authorship/multilingual_style_representation",
      "loader": "sentence_transformers",
      "expected_dimension": 1024,
      "maximum_sequence_length": 512,
      "batch_size": 8,
      "normalize_embeddings": true,
      "local_finetuning_forbidden": true
    },
    "mstyledistance": {
      "repo_id": "StyleDistance/mstyledistance",
      "revision": "d66ed25e48225a503b21a65bc804caf06c886f96",
      "local_path": "models/step24/authorship/mstyledistance",
      "loader": "sentence_transformers",
      "expected_dimension": 768,
      "maximum_sequence_length": 512,
      "batch_size": 16,
      "normalize_embeddings": true,
      "local_finetuning_forbidden": true
    }
  },
  "evaluation": {
    "canonical_split": "train",
    "fold_count": 5,
    "fold_seed": 20260717,
    "source_only_training": "english_labels_only",
    "target_grouped_oof_training": "all_english_train_plus_four_fifths_chinese_train",
    "model_specs": {
      "P0_raw_style_matched_missingness": {
        "style_features": [
          "raw_pcm_multilingual_authorship_cosine",
          "raw_mstyledistance_cosine"
        ],
        "reliability_feature": "pair_local_style_reliable",
        "missingness_mode": "fold_train_reliable_median_plus_indicator",
        "selection_role": "matched_baseline"
      },
      "P1_global_clean_style_matched_missingness": {
        "style_features": [
          "global_clean_pcm_multilingual_authorship_cosine",
          "global_clean_mstyledistance_cosine"
        ],
        "reliability_feature": "global_and_pair_local_style_reliable",
        "missingness_mode": "fold_train_reliable_median_plus_indicator",
        "selection_role": "diagnostic_control"
      },
      "P2_pair_local_clean_style_matched_missingness": {
        "style_features": [
          "pair_local_clean_pcm_multilingual_authorship_cosine",
          "pair_local_clean_mstyledistance_cosine"
        ],
        "reliability_feature": "pair_local_style_reliable",
        "missingness_mode": "fold_train_reliable_median_plus_indicator",
        "selection_role": "preregistered_primary_diagnostic"
      },
      "P3_pair_local_clean_raw_fallback": {
        "style_features": [
          "pair_local_or_raw_pcm_multilingual_authorship_cosine",
          "pair_local_or_raw_mstyledistance_cosine"
        ],
        "reliability_feature": "pair_local_style_reliable",
        "missingness_mode": "raw_style_fallback_plus_indicator",
        "selection_role": "sensitivity_only"
      }
    },
    "P4_reliable_pair_only_sensitivity": {
      "compare": [
        "P0_raw_style_matched_missingness",
        "P2_pair_local_clean_style_matched_missingness"
      ],
      "fit_scope": "same_models_as_full_boundary",
      "metric_scope": "rows_with_pair_local_style_reliable_equal_1",
      "selection_forbidden": true
    },
    "primary_model": "P2_pair_local_clean_style_matched_missingness",
    "matched_baseline_model": "P0_raw_style_matched_missingness",
    "global_detector_control": "P1_global_clean_style_matched_missingness",
    "fallback_control": "P3_pair_local_clean_raw_fallback",
    "primary_matched_missingness_indicator": "pair_local_style_reliable",
    "unreliable_style_value_in_persisted_pair_table": "nan",
    "zero_cosine_as_missing_value_forbidden": true,
    "imputation_fit_scope": "inside_each_component_grouped_training_fold_only",
    "secondary_controls_forbidden_for_selection": true,
    "candidate_selection_forbidden": true,
    "valid_or_test_selection_forbidden": true,
    "logistic": {
      "l2_penalty": 10.0,
      "max_iter": 400,
      "tolerance": 1e-8,
      "class_weight": "none",
      "standardize_features": true,
      "sample_weight_total_normalization": "real_train_row_count"
    },
    "grouped_bootstrap_resamples": 5000,
    "grouped_bootstrap_seed": 20260718,
    "development_metric": "average_precision",
    "required_slices": [
      "canonical_non_silver",
      "direct_component_positive_plus_all_negatives",
      "soft_positive_plus_all_negatives",
      "reliable_pair_only"
    ]
  },
  "mechanism_diagnostic_gates": {
    "minimum_source_only_ap_delta_over_matched_raw": -0.01,
    "minimum_target_oof_ap_delta_over_matched_raw": -0.01,
    "minimum_source_only_bootstrap_lower_bound": -0.02,
    "minimum_target_oof_bootstrap_lower_bound": -0.02,
    "minimum_target_direct_component_ap_delta": -0.02,
    "maximum_target_template_clone_mean_rank_percentile_delta": -0.02,
    "maximum_target_template_clone_violation_rate_delta": -0.03,
    "minimum_reliable_pair_fraction": 0.50,
    "interpretation": "Passing supports only the pair-local mechanism hypothesis. It cannot promote a model, unlock Step11/17, or reverse the frozen Step25-v1 conclusion."
  },
  "outputs": {
    "pair_local_texts_en": "pair_local_texts.en_content_train_pool.jsonl",
    "pair_local_texts_zh": "pair_local_texts.zh_target_strict.jsonl",
    "detector_summary": "pair_local_copy_detection_summary.json",
    "embedding_manifest": "pair_local_style_embedding_manifest.json",
    "pair_features_en": "pair_features.en_content_train_pool.csv",
    "pair_features_zh": "pair_features.zh_target_strict.csv",
    "pair_feature_summary": "pair_feature_summary.json",
    "predictions_en": "step25_v2_grouped_oof_predictions.en.csv",
    "predictions_zh": "step25_v2_grouped_oof_predictions.zh.csv",
    "model_artifacts": "step25_v2_model_artifacts.json",
    "evaluation_summary": "step25_v2_evaluation_summary.json",
    "sync_manifest": "step25_v2_sync_manifest.json"
  },
  "scientific_constraints": [
    "Step25-v1 and Step24 remain immutable inputs and are never overwritten.",
    "The detector reads only the two identifier-redacted texts belonging to the current canonical train pair.",
    "No detector threshold may be selected from labels, evidence types, model errors, valid, test or D0 performance.",
    "P0 and P2 use the exact same pair-local reliability mask and fold-train imputation contract; P1 uses the stricter global-and-pair-local reliability intersection because the frozen v1 global representation has its own missingness boundary.",
    "A missing cleaned style value is never represented by cosine zero.",
    "P3 raw fallback and P4 reliable-only metrics are sensitivity analyses and cannot select the method.",
    "D0 is retrospective and cannot authorize D1 eligibility, publication promotion or Step11/17 execution.",
    "No synthetic text, pair or identity label is generated."
  ]
}
