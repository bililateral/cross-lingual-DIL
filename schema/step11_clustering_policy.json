    "mainline_guidance": {
      "primary_discovery_family": "core_few_shot_multilingual_e5_large_lr_l2_ratio_50pct",
      "primary_discovery_graph_threshold": 0.56,
      "primary_discovery_rationale": "Use the clean E5-large + L2 logistic few-shot scorer as the current scientific discovery graph because the 2026-04-23 Step 9 rerun makes it the strongest clean few-shot candidate by ratio-level zh_test ROC-AUC/AP. Treat this as a graph triage scorer, not as ground truth; its lift over raw E5 semantic ranking is small and must be audited at cluster level.",
