  "graph_policy": {
    "node_key": "seller_uid",
    "edge_key": "pair_uid",
    "edge_weight": "prob_positive",
    "algorithm": "connected_components",
    "minimum_cluster_size": 2,
    "graph_scope": "zh_target_strict candidate-pair universe only",
    "graph_edge_filters": {
      "enabled": true,
      "require_shared_neighbor_count_min": 1,
      "reciprocal_top_k": 5,
      "require_triangle_participation": false,
      "shared_neighbor_pruning_mode": "iterative",
      "shared_neighbor_pruning_max_passes": 25,
      "relation_reliability_filter": {
        "enabled": true,
        "description": "Validation/rule-driven edge reliability filter inspired by spurious-edge filtering. It separates identity reliability from semantic similarity before reciprocal-top-k and shared-neighbor pruning.",
        "minimum_score": 0.3,
        "minimum_score_overrides": {},
        "hard_keep_direct_identity": true,
        "base_score": 0.2,
        "weights": {
          "shared_pgp_fingerprint": 0.45,
          "shared_seller_contact": 0.35,
          "rare_description_clone": 0.15,
          "rare_title_clone": 0.1,
          "rare_ngram_support": 0.08,
          "structural_support": 0.12,
          "style_consistency": 0.08,
          "boilerplate_template_penalty": -0.2,
          "semantic_topic_only_penalty": -0.25
