        "thresholds": {
          "rare_description_idf_mean_min": 2.0,
          "rare_title_idf_mean_min": 2.0,
          "rare_ngram_count_min": 2.0,
          "structural_support_min": 0.5,
          "category_jaccard_min": 0.5,
          "style_consistency_min": 0.72,
          "boilerplate_ratio_max_penalty_min": 0.75,
          "shared_boilerplate_count_penalty_min": 3.0,
          "semantic_topic_similarity_min": 0.75
        }
      },
      "direct_keep_threshold_overrides": {}
    }
  },
