    "seller_perturbation_rule": "Select exactly two distinct factors in style_factor_order by the registered text-key HMAC order and move each inherited value forward by one position in its domain with wraparound.",
    "line_rendering": {
      "single_separator": "{separator}",
      "double_separator": "{separator}\\n",
      "bullet_separator": "\\n• ",
      "bullet_description_prefix": "• ",
      "title_modifier_rule": "map the parser-safe item code's penultimate A..P symbol bijectively to the 16 generic title modifiers; use only in the four title skeletons per split that do not expose the code",
      "english_tag_location": "append one ASCII space plus the nonempty tag only when the parser-safe item code's final A..P symbol is A, B or C; this label-blind 3/16 visibility gate avoids a universal title suffix",
      "repeat_punctuation_rule": "replace each base-description ending slot with ending repeated exactly twice",
      "scope": "base title and base description only; noise, context_guard and identity clauses are immutable"
