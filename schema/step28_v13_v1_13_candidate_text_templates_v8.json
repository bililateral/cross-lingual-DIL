      "line_mode": ["single", "double", "bullet"],
      "english_tag": ["", "V2", "PRO", "OK", "PLUS", "NEW", "S", "X", "LITE"],
      "traditional_variant": [false, true],
      "repeat_punctuation": [false, true]
