{
  "version": "2026-03-11",
  "objective": "Step-4 silver-label candidate mining schema for cross-lingual sockpuppet-account research",
  "input_dependencies": [
    "reports/step3_seller_profiles.en_content_train_pool.jsonl",
    "reports/step3_seller_profiles.zh_target_strict.jsonl",
    "reports/step3_seller_profiles.zh_target_aux.jsonl",
    "reports/step2_aux_pgp_evidence_manifest.csv"
  ],
  "candidate_pools": [
    {
      "data_bucket": "en_content_train_pool",
      "language": "en"
    },
    {
      "data_bucket": "zh_target_strict",
      "language": "zh"
    },
    {
      "data_bucket": "zh_target_aux",
      "language": "zh"
    }
  ],
  "candidate_rules": [
    "shared_contact_exact",
    "shared_description_clone",
    "shared_title_clone",
    "shared_pgp_fingerprint_via_aux_alias",
    "profile_lexical_neighbor",
    "structural_support"
  ],
  "hard_rules": [
    "Step 4 outputs review candidates only; no pair is auto-promoted to a final silver label.",
    "Every candidate pair must retain explicit evidence codes and manual review fields.",
    "Candidate generation must operate only on Step-3 seller profiles from eligible Step-2 buckets.",
    "Chinese retrieval must use character-level features rather than whitespace tokenization.",
    "Retrieval and clone evidence should consume Step-3 signature fields when available.",
    "products_data.csv remains separated in zh_target_aux and is not merged into zh_target_strict.",
    "Same-alias continuity pairs must be tagged explicitly and kept distinct from primary sockpuppet review scope."
  ],
  "tokenization_policy": {
    "en": "word tokens + word bigrams over profile overview and signature fields",
    "zh": "character 2-3 grams plus Latin alphanumeric tokens over profile overview and signature fields"
  },
  "filtering_policy": {
    "contact_noise_stopwords": [
      "app",
      "before",
      "below",
      "contact",
      "account",
      "address",
      "email",
      "estellt",
      "for",
      "from",
      "group",
      "mail",
      "message",
      "messages",
      "messenger",
      "name",
      "private",
      "ship_from",
      "ssages",
      "support",
      "telegram",
      "wechat",
      "whatsapp",
      "wickr",
      "youtube"
    ],
    "duplicate_cluster_limits": {
      "shared_contact_exact": 8,
      "shared_description_clone": 5,
      "shared_title_clone": 5,
      "shared_pgp_fingerprint_via_aux_alias": 8
    },
    "content_minimums": {
      "en_title_min_chars": 15,
      "en_title_min_tokens": 3,
      "en_description_min_chars": 80,
      "zh_title_min_cjk_chars": 8,
      "zh_description_min_cjk_chars": 24
    }
  },
  "retrieval_policy": {
    "en_content_train_pool": {
      "max_df_ratio": 0.03,
      "max_df_cap": 160,
      "min_df": 2,
      "top_terms_per_profile": 100,
      "top_neighbors_per_profile": 15,
      "min_cosine_similarity": 0.16,
      "strong_cosine_similarity": 0.24
    },
    "zh_target_strict": {
      "max_df_ratio": 0.025,
      "max_df_cap": 120,
      "min_df": 2,
      "top_terms_per_profile": 140,
      "top_neighbors_per_profile": 15,
      "min_cosine_similarity": 0.14,
      "strong_cosine_similarity": 0.2
    },
    "zh_target_aux": {
      "max_df_ratio": 0.04,
      "max_df_cap": 60,
      "min_df": 2,
      "top_terms_per_profile": 140,
      "top_neighbors_per_profile": 12,
      "min_cosine_similarity": 0.12,
      "strong_cosine_similarity": 0.18
    }
  },
  "candidate_output_fields": [
    "pair_uid",
    "candidate_language",
    "data_bucket",
    "candidate_scope",
    "seller_uid_left",
    "seller_uid_right",
    "source_market_raw_left",
    "source_market_raw_right",
    "source_seller_raw_left",
    "source_seller_raw_right",
    "alias_normalized_left",
    "alias_normalized_right",
    "alias_relation",
    "same_market_raw",
    "item_count_left",
    "item_count_right",
    "shared_contact_count",
    "shared_contact_types",
    "shared_contact_values",
    "shared_title_count",
    "shared_title_values",
    "shared_description_count",
    "shared_description_values",
    "shared_category_count",
    "shared_category_values",
    "lexical_similarity",
    "structural_support_score",
    "item_count_ratio",
    "price_median_ratio",
    "style_distance_l1",
    "shared_pgp_fingerprint_count",
    "shared_pgp_fingerprint_values",
    "pgp_alias_hit_count_left",
    "pgp_alias_hit_count_right",
    "candidate_rule_hits",
    "candidate_rule_count",
    "candidate_rank_score",
    "review_priority",
    "left_preview",
    "right_preview",
    "review_status",
    "review_label",
    "reviewer_id",
    "review_notes"
  ],
  "manual_review_defaults": {
    "review_status": "pending",
    "review_label": "",
    "reviewer_id": "",
    "review_notes": ""
  },
  "acceptance_checks": [
    "Each candidate table must include explicit rule-hit columns and manual review columns.",
    "No candidate pair may be assigned a final positive or negative label at Step 4.",
    "Each pool-specific review queue must be deterministically sorted and reproducible from the same inputs.",
    "Candidate scope must distinguish same-alias continuity from primary sockpuppet review candidates."
  ]
}
