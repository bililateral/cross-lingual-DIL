{
  "version": "2026-07-16-step21-v2-balanced-grouped-oof",
  "objective": "Generate auditable Chinese train-only positive-pair text augmentations without creating new benchmark labels or independent real-world identities.",
  "inputs": {
    "frozen_labels": "reports/step5_zh_target_strict_frozen_silver_labels.csv",
    "evidence_labels": "reports/step15_evidence_type_labels.zh_target_strict.csv",
    "seller_profiles": "reports/step3_seller_profiles.zh_target_strict.jsonl",
    "item_identity_signals": "reports/step3_item_identity_signals.zh_target_strict.csv",
    "component_assignments": "reports/step16i_data_integrity/step16i_integrity_20260716_v2/component_assignments.csv",
    "v7_policy": "schema/step15_v7_two_stage_policy.json",
    "semantic_model_policy": "schema/step7_semantic_model_policy.json"
  },
  "outputs_root": "reports/step21_synthetic_train_only/v2_balanced_grouped_oof_20260716",
  "global_seed": 20260716,
  "tracks": {
    "primary_non_silver": {
      "description": "Primary train-only augmentation from non-silver frozen Chinese train positives. This is not a claim of direct-anchor gold quality.",
      "silver_train_only": false,
      "allowed_evidence_types": [
        "same_controller_direct_identifier",
        "same_controller_component_anchor",
        "same_controller_style_structural_soft"
      ],
      "variants_per_parent_pair": 3,
      "minimum_parent_pairs": 10
    },
    "sensitivity_silver_anchor": {
      "description": "Sensitivity-only augmentation from silver direct/component-anchor train positives; never merge with the primary result.",
      "silver_train_only": true,
      "allowed_evidence_types": [
        "same_controller_direct_identifier",
        "same_controller_component_anchor"
      ],
      "variants_per_parent_pair": 2,
      "minimum_parent_pairs": 20
    }
  },
  "eligibility": {
    "required_split_name": "train",
    "required_review_label": "positive",
    "required_usable_for_supervision": true,
    "required_usable_for_core_transfer": true,
    "forbidden_splits": [
      "valid",
      "test",
      "audit_only",
      "uncertain_holdout",
      "internal_development_test",
      "prospective_holdout"
    ]
  },
  "generation": {
    "identifier_redaction_required": true,
    "source_text_fields": [
      "category_concat_top",
      "signature_title_concat",
      "title_concat_top",
      "signature_description_concat",
      "description_concat_top"
    ],
    "transform_schedule": [
      "section_rotation",
      "segment_subsample",
      "layout_punctuation_normalization"
    ],
    "require_at_least_one_changed_side_per_synthetic_pair": true,
    "no_op_fallback": "deterministic_section_rotation_both_sides_then_fail_closed",
    "synthetic_market_marker": "SYNTHETIC_TRAIN_ONLY",
    "synthetic_uid_prefix": "synthetic://step21/v2",
    "copy_parent_nonsemantic_profile_statistics": true,
    "fabricate_identifiers": false,
    "fabricate_market_provenance": false
  },
  "weighting": {
    "synthetic_budget_per_parent_multiplier": 1.0,
    "child_weight_formula": "parent_training_sample_weight_times_budget_multiplier_divided_by_variants_per_parent_pair",
    "equal_effective_weight_duplication_control_required": true,
    "maximum_total_synthetic_weight_per_parent_relative_to_parent": 1.0
  },
  "evaluation": {
    "experiments": [
      "no_augmentation",
      "equal_effective_weight_duplication",
      "identifier_redacted_text_augmentation"
    ],
    "selection_scope": "five_fold_grouped_oof_on_train_seller_components_only",
    "selection_metric": "average_precision",
    "forbid_valid_or_test_selection": true,
    "final_holdout": "Step20 genuinely prospective real data only"
  },
  "outputs": {
    "summary": "step21_synthetic_generation_summary.json",
    "manifest": "step21_synthetic_generation_manifest.json",
    "tracks_directory": "tracks"
  },
  "scientific_constraints": [
    "Synthetic rows are augmentation records, not independent seller identities or newly collected sockpuppet positives.",
    "Synthetic rows never enter Step5 frozen labels, zh_valid, zh_test, Step16I Dev2, or Step20.",
    "Every synthetic row inherits its parent split component and is grouped with that parent in resampling and cross-validation.",
    "The primary and sensitivity tracks are physically separate and must be reported separately.",
    "A gain over no augmentation is insufficient unless it also exceeds the equal-effective-weight duplication control.",
    "Effective independent sample size is the number of real parent components, never the number of generated rows."
  ]
}
