        "same_controller_component_anchor": 1.15,
        "same_controller_style_structural_soft": 0.7,
        "ordinary_negative": 1.0,
        "semantic_topic_not_controller": 1.15,
        "template_clone_not_controller": 1.15,
        "public_contact_or_url_noise": 1.5
      }
    },
    "confidence_factor": {
      "source": "training_sample_weight",
      "minimum": 0.18,
      "maximum": 1.0
    },
    "component_factor": "inverse_pairs_per_split_component_sqrt_normalized_within_domain_and_evidence_type",
    "min_weight": 0.1,
    "max_weight": 2.5,
    "forbid_global_eight_x_multiplier": true
