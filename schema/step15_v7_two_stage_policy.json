    "logistic": {
      "l2_penalty": 10.0,
      "max_iter": 200,
      "tolerance": 1e-8,
      "class_weight": "none",
      "standardize_features": true,
      "standardization_reference": "real_train_rows_only_shared_across_all_three_controls",
      "sample_weight_total_normalization": "real_train_row_count_shared_across_all_three_controls"
    },
    "outputs_root": "reports/step9_v7_latent_mixup"
  },
  "factorized_evidence_weighting": {
    "formula": "clip(domain_factor * evidence_type_factor[domain] * confidence_factor * component_factor, min_weight, max_weight)",
    "domain_factor": {"en": 1.0, "zh": 1.0},
    "evidence_type_factor": {
      "en": {
        "same_controller_direct_identifier": 1.0,
        "same_controller_component_anchor": 1.0,
        "same_controller_style_structural_soft": 0.8,
        "ordinary_negative": 1.0,
        "semantic_topic_not_controller": 1.1,
        "template_clone_not_controller": 1.1,
        "public_contact_or_url_noise": 0.75
