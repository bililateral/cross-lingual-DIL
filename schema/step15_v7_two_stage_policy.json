  "latent_pair_representation": {
    "encoder": "multilingual_e5_large_identifier_redacted_frozen_v7_cache",
    "symmetric_operator": ["abs_left_minus_right", "elementwise_product"],
    "projection": "fixed_gaussian_johnson_lindenstrauss",
    "projection_seed": 2026071301,
    "projection_dimensions": 64,
    "projection_scale": "one_over_sqrt_output_dimensions",
    "raw_embeddings_are_never_mixed_across_domains": true
  },
  "step9_latent_mixup": {
    "default_run_id": "v2_identifier_redacted_20260714",
    "support_ratios": [0.0, 0.1, 0.2, 0.5, 1.0],
    "seeds": [20260320, 20260321, 20260322, 20260323, 20260324, 20260325, 20260326, 20260327, 20260328, 20260329],
    "experiments": [
      "no_augmentation",
      "equal_effective_weight_duplication",
      "latent_pair_embedding_mixup"
    ],
    "mixup": {
      "beta_alpha": 0.4,
      "same_domain_only": true,
      "target_domain_only": true,
      "same_evidence_type_only": true,
      "minimum_parent_confidence": 0.55,
      "nearest_neighbor_k": 5,
      "gap_reference_scope": "target_domain_support_only",
      "synthetic_positive_target": "close_50pct_of_real_negative_minus_positive_effective_weight_gap",
      "target_effective_weight_gap_closure_fraction": 0.5,
      "max_synthetic_rows_per_eligible_parent": 5,
      "clean_feature_policy": "copy_anchor_parent",
      "latent_feature_policy": "convex_interpolation",
      "synthetic_weight_policy": "minimum_parent_factorized_weight_capped_to_remaining_budget"
    },
    "duplication_control": {
      "same_parent_schedule_and_weights_as_mixup": true,
      "latent_feature_policy": "copy_anchor_parent",
      "required_total_synthetic_effective_weight_tolerance": 1e-10
